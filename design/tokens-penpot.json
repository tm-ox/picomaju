{
  "$metadata": {
    "tokenSetOrder": ["global", "semantic/light", "semantic/dark"]
  },

  "global": {
    "color": {
      "brand": {
        "crimson":   { "$type": "color", "$value": "#bf092f" },
        "navy-dark": { "$type": "color", "$value": "#132440" },
        "navy":      { "$type": "color", "$value": "#16476a" },
        "teal":      { "$type": "color", "$value": "#3b9797" }
      }
    },
    "font": {
      "family": {
        "brand": { "$type": "fontFamily", "$value": "URW Gothic, Urbanist, system-ui, sans-serif" },
        "ui":    { "$type": "fontFamily", "$value": "Inter, system-ui, -apple-system, sans-serif" },
        "mono":  { "$type": "fontFamily", "$value": "JetBrains Mono, ui-monospace, monospace" }
      },
      "size": {
        "2xs":  { "$type": "dimension", "$value": "0.6875rem" },
        "xs":   { "$type": "dimension", "$value": "0.75rem" },
        "sm":   { "$type": "dimension", "$value": "0.8125rem" },
        "base": { "$type": "dimension", "$value": "0.875rem" },
        "md":   { "$type": "dimension", "$value": "0.9375rem" },
        "lg":   { "$type": "dimension", "$value": "1.125rem" },
        "xl":   { "$type": "dimension", "$value": "1.25rem" },
        "2xl":  { "$type": "dimension", "$value": "1.5rem" },
        "3xl":  { "$type": "dimension", "$value": "1.75rem" }
      },
      "weight": {
        "regular":  { "$type": "fontWeight", "$value": 400 },
        "medium":   { "$type": "fontWeight", "$value": 500 },
        "semibold": { "$type": "fontWeight", "$value": 600 },
        "bold":     { "$type": "fontWeight", "$value": 700 }
      }
    },
    "space": {
      "1":  { "$type": "dimension", "$value": "0.125rem" },
      "2":  { "$type": "dimension", "$value": "0.25rem" },
      "3":  { "$type": "dimension", "$value": "0.375rem" },
      "4":  { "$type": "dimension", "$value": "0.5rem" },
      "5":  { "$type": "dimension", "$value": "0.625rem" },
      "6":  { "$type": "dimension", "$value": "0.75rem" },
      "7":  { "$type": "dimension", "$value": "0.875rem" },
      "8":  { "$type": "dimension", "$value": "1rem" },
      "9":  { "$type": "dimension", "$value": "1.25rem" },
      "10": { "$type": "dimension", "$value": "1.5rem" },
      "11": { "$type": "dimension", "$value": "1.75rem" },
      "12": { "$type": "dimension", "$value": "2rem" },
      "13": { "$type": "dimension", "$value": "2.5rem" }
    },
    "radius": {
      "sm":   { "$type": "dimension", "$value": "6px" },
      "base": { "$type": "dimension", "$value": "8px" },
      "md":   { "$type": "dimension", "$value": "12px" },
      "lg":   { "$type": "dimension", "$value": "16px" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "z": {
      "sticky":  { "$type": "number", "$value": 100 },
      "fab":     { "$type": "number", "$value": 199 },
      "overlay": { "$type": "number", "$value": 200 }
    },
    "layout": {
      "topnav-h": { "$type": "dimension", "$value": "3.25rem" },
      "tabbar-h": { "$type": "dimension", "$value": "4.25rem" }
    }
  },

  "semantic/light": {
    "color": {
      "bg":             { "$type": "color", "$value": "#f4f7fa" },
      "surface":        { "$type": "color", "$value": "#ffffff" },
      "surface-subtle": { "$type": "color", "$value": "#edf2f6" },

      "accent":       { "$type": "color", "$value": "{color.brand.crimson}" },
      "accent-fg":    { "$type": "color", "$value": "#ffffff" },
      "accent-hover": { "$type": "color", "$value": "#a50827" },
      "accent-soft":  { "$type": "color", "$value": "#fceaee" },

      "nav-bg":            { "$type": "color", "$value": "{color.brand.navy-dark}" },
      "nav-fg":            { "$type": "color", "$value": "#ffffff" },
      "nav-link":          { "$type": "color", "$value": "#8baabe" },
      "nav-link-hover":    { "$type": "color", "$value": "#c8dae8" },
      "nav-active":        { "$type": "color", "$value": "#ffffff" },
      "nav-overlay":       { "$type": "color", "$value": "rgba(255, 255, 255, 0.15)" },
      "nav-overlay-hover": { "$type": "color", "$value": "rgba(255, 255, 255, 0.3)" },

      "text":           { "$type": "color", "$value": "#0f1f38" },
      "text-secondary": { "$type": "color", "$value": "#4a6179" },
      "text-muted":     { "$type": "color", "$value": "#7b92a8" },
      "text-faint":     { "$type": "color", "$value": "{color.brand.teal}" },

      "border":       { "$type": "color", "$value": "#dbe4ec" },
      "border-light": { "$type": "color", "$value": "#eaf0f5" },
      "border-faint": { "$type": "color", "$value": "#eef3f7" },

      "danger":      { "$type": "color", "$value": "{color.brand.crimson}" },
      "danger-fg":   { "$type": "color", "$value": "#ffffff" },
      "interactive": { "$type": "color", "$value": "{color.brand.teal}" },

      "ok-bg":     { "$type": "color", "$value": "#f0faf4" },
      "ok-border": { "$type": "color", "$value": "#6dbf8e" },
      "ok-text":   { "$type": "color", "$value": "#155c30" },

      "error-bg":     { "$type": "color", "$value": "#fdf0f2" },
      "error-border": { "$type": "color", "$value": "#e87a90" },
      "error-text":   { "$type": "color", "$value": "#7a1020" },

      "warn-bg":     { "$type": "color", "$value": "#fdf8ec" },
      "warn-border": { "$type": "color", "$value": "#e0b84a" },
      "warn-text":   { "$type": "color", "$value": "#6b4a10" },

      "code-bg":   { "$type": "color", "$value": "{color.brand.navy-dark}" },
      "code-text": { "$type": "color", "$value": "#c8dae8" }
    }
  },

  "semantic/dark": {
    "color": {
      "bg":             { "$type": "color", "$value": "#0c1826" },
      "surface":        { "$type": "color", "$value": "#142640" },
      "surface-subtle": { "$type": "color", "$value": "#1a3251" },

      "accent":       { "$type": "color", "$value": "{color.brand.crimson}" },
      "accent-fg":    { "$type": "color", "$value": "#ffffff" },
      "accent-hover": { "$type": "color", "$value": "#d40f35" },
      "accent-soft":  { "$type": "color", "$value": "#2a0a14" },

      "nav-bg":            { "$type": "color", "$value": "#080f1a" },
      "nav-fg":            { "$type": "color", "$value": "#ffffff" },
      "nav-link":          { "$type": "color", "$value": "#6c8fa8" },
      "nav-link-hover":    { "$type": "color", "$value": "#a8c4d6" },
      "nav-active":        { "$type": "color", "$value": "#ffffff" },
      "nav-overlay":       { "$type": "color", "$value": "rgba(255, 255, 255, 0.1)" },
      "nav-overlay-hover": { "$type": "color", "$value": "rgba(255, 255, 255, 0.2)" },

      "text":           { "$type": "color", "$value": "#d8eaf4" },
      "text-secondary": { "$type": "color", "$value": "#9abdd0" },
      "text-muted":     { "$type": "color", "$value": "#5a8a9f" },
      "text-faint":     { "$type": "color", "$value": "{color.brand.teal}" },

      "border":       { "$type": "color", "$value": "#1e3a55" },
      "border-light": { "$type": "color", "$value": "#1a3050" },
      "border-faint": { "$type": "color", "$value": "#14263f" },

      "danger":      { "$type": "color", "$value": "{color.brand.crimson}" },
      "danger-fg":   { "$type": "color", "$value": "#ffffff" },
      "interactive": { "$type": "color", "$value": "{color.brand.teal}" },

      "ok-bg":     { "$type": "color", "$value": "#0d2618" },
      "ok-border": { "$type": "color", "$value": "#2a6b42" },
      "ok-text":   { "$type": "color", "$value": "#5dba7a" },

      "error-bg":     { "$type": "color", "$value": "#280810" },
      "error-border": { "$type": "color", "$value": "#7a1828" },
      "error-text":   { "$type": "color", "$value": "#e8808e" },

      "warn-bg":     { "$type": "color", "$value": "#251a08" },
      "warn-border": { "$type": "color", "$value": "#7a5418" },
      "warn-text":   { "$type": "color", "$value": "#dba84a" },

      "code-bg":   { "$type": "color", "$value": "#080f1a" },
      "code-text": { "$type": "color", "$value": "#8ab8d0" }
    }
  }
}
