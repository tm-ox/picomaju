package templates

import icons "github.com/bryanvaz/go-templ-lucide-icons"

// AppLayout is the full authenticated shell: collapsible sidebar + in-content nav + scrollable content.
// nav is rendered between the sidebar header and the settings/theme footer.
templ AppLayout(title string, nd NavData, nav templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<title>{ title } — Picomaju</title>
			<link rel="stylesheet" href="/ui/assets/css/output.css"/>
			<script type="module" src="/static/datastar.js"></script>
			<script>
				(function () {
					var t =
						localStorage.getItem("theme") ||
						(matchMedia("(prefers-color-scheme:dark)").matches
							? "dark"
							: "light");
					if (t === "dark") document.documentElement.classList.add("dark");
				})();
			</script>
		</head>
		<body class="flex h-dvh overflow-hidden bg-background">
			<style>
				#sidebar {
					transition: width 200ms ease;
				}
				#sidebar-main {
					transition: transform 200ms ease;
				}
			</style>
			<aside
				id="sidebar"
				class="bg-sidebar text-sidebar-foreground flex flex-col shrink-0 overflow-y-auto overflow-x-hidden border-r border-sidebar-border"
			>
				<div class="border-b border-sidebar-border shrink-0 h-12 flex items-center">
					<div class="flex items-center w-full mx-2 px-1">
						<span data-sidebar-label class="size-8 shrink-0 flex items-center justify-center">
							<div class="size-7 rounded-md bg-primary text-primary-foreground font-brand font-bold text-[0.625rem] flex items-center justify-center tracking-wide select-none">
								{ navInitials(nd.BusinessName) }
							</div>
						</span>
						<span data-sidebar-label class="text-sm font-brand font-semibold text-sidebar-foreground/90 truncate flex-1 min-w-0 pl-2">
							if nd.BusinessName != "" {
								{ nd.BusinessName }
							} else {
								PicoMaju
							}
						</span>
						<button
							onclick="toggleSidebar()"
							class="hidden sm:flex size-8 shrink-0 ml-auto items-center justify-center rounded-md text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent transition-colors cursor-pointer"
							aria-label="Toggle sidebar"
						>
							@icons.PanelLeft(templ.Attributes{"class": "size-4"})
						</button>
					</div>
				</div>
				@nav
				<div class="mt-auto border-t border-sidebar-border shrink-0 py-2">
					@SidebarItem("/settings", "Settings", "settings", nd.ActiveSection) {
						@icons.Settings(templ.Attributes{"class": "size-4"})
					}
					@sidebarThemeToggle()
				</div>
			</aside>
			<div id="sidebar-backdrop" class="fixed inset-0 z-40 bg-black/30 hidden" onclick="toggleSidebar()"></div>
			<div id="sidebar-main" class="flex-1 min-w-0 flex flex-col overflow-hidden">
				<header class="shrink-0 h-12 flex items-center border-b border-border px-4">
					<div class="flex-1 flex">
						<button
							class="flex sm:hidden size-8 items-center justify-center rounded-md text-muted-foreground hover:text-foreground hover:bg-muted transition-colors cursor-pointer"
							onclick="toggleSidebar()"
							aria-label="Open sidebar"
						>
							@icons.PanelLeft(templ.Attributes{"class": "size-4"})
						</button>
					</div>
					<nav class="hidden sm:flex items-center gap-0.5" aria-label="Primary">
						@appNavLink("/", "Staff", nd.ActiveSection == "staff")
						@appNavLink("/values", "Values", nd.ActiveSection == "values")
						@appNavLink("/tools", "Tools", nd.ActiveSection == "tools")
						@appNavLink("/tasks", "Tasks", nd.ActiveSection == "tasks")
					</nav>
					<div class="flex-1"></div>
				</header>
				<div class="flex-1 overflow-y-auto">
					<div class="max-w-2xl mx-auto w-full px-4 py-6 flex flex-col gap-6">
						{ children... }
					</div>
				</div>
				@AppBottomTabBar(nd)
			</div>
			<script>
				(function () {
					var KEY = "sidebar";
					var W = "14rem";
					var ICON_W = "3.5rem";

					function isMobile() {
						return window.innerWidth < 640;
					}

					function apply(open) {
						var sb = document.getElementById("sidebar");
						var main = document.getElementById("sidebar-main");
						var bd = document.getElementById("sidebar-backdrop");
						var labels = sb.querySelectorAll("[data-sidebar-label]");

						if (isMobile()) {
							if (open) {
								sb.style.width = W;
								sb.style.position = "absolute";
								sb.style.zIndex = "50";
								sb.style.height = "100%";
								main.style.transform = "translateX(" + W + ")";
								bd.classList.remove("hidden");
								labels.forEach(function (el) {
									el.style.display = "";
								});
							} else {
								sb.style.width = "0";
								sb.style.position = "";
								sb.style.zIndex = "";
								sb.style.height = "";
								main.style.transform = "";
								bd.classList.add("hidden");
								labels.forEach(function (el) {
									el.style.display = "none";
								});
							}
						} else {
							sb.style.position = "";
							sb.style.zIndex = "";
							sb.style.height = "";
							main.style.transform = "";
							bd.classList.add("hidden");
							sb.style.width = open ? W : ICON_W;
							labels.forEach(function (el) {
								el.style.display = open ? "" : "none";
							});
						}

						localStorage.setItem(KEY, open ? "open" : "closed");
					}

					window.toggleSidebar = function () {
						var saved = localStorage.getItem(KEY);
						var current = saved !== null ? saved === "open" : !isMobile();
						apply(!current);
					};

					var saved = localStorage.getItem(KEY);
					apply(saved !== null ? saved === "open" : !isMobile());

					window.addEventListener("resize", function () {
						var saved = localStorage.getItem(KEY);
						apply(saved !== null ? saved === "open" : !isMobile());
					});
				})();
			</script>
		</body>
	</html>
}

// sidebarThemeToggle is a button styled as a SidebarItem that toggles light/dark mode.
templ sidebarThemeToggle() {
	<button
		class="flex items-center gap-2 w-full mx-2 px-1 py-0.5 rounded-md text-sm transition-colors text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent cursor-pointer"
		aria-label="Toggle theme"
		onclick="var d=document.documentElement,dark=d.classList.toggle('dark');localStorage.setItem('theme',dark?'dark':'light');"
	>
		<span class="size-8 shrink-0 flex items-center justify-center">
			<svg class="block dark:hidden size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
			</svg>
			<svg class="hidden dark:block size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="12" cy="12" r="4"></circle>
				<path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
			</svg>
		</span>
		<span data-sidebar-label>Theme</span>
	</button>
}

// Layout is the unauthenticated page shell.
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/ui/assets/css/output.css"/>
			<script>
				(function () {
					var t =
						localStorage.getItem("theme") ||
						(matchMedia("(prefers-color-scheme:dark)").matches
							? "dark"
							: "light");
					if (t === "dark") document.documentElement.classList.add("dark");
				})();
			</script>
		</head>
		<body>
			@ThemeToggle()
			{ children... }
		</body>
	</html>
}

templ ThemeToggle() {
	<button
		class="fixed top-4 right-4 z-50 inline-flex size-9 items-center justify-center rounded-md border border-input bg-background text-foreground shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 cursor-pointer"
		aria-label="Toggle theme"
		onclick="var d=document.documentElement,dark=d.classList.toggle('dark');localStorage.setItem('theme',dark?'dark':'light');this.setAttribute('aria-pressed',dark?'true':'false');"
	>
		<svg class="block dark:hidden size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
		</svg>
		<svg class="hidden dark:block size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
		</svg>
	</button>
}
