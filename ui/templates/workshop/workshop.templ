package workshoptpl

import (
	"picomaju/ui/components/alert"
	"picomaju/ui/components/button"
	"picomaju/ui/components/card"
	"picomaju/ui/components/input"
	"picomaju/ui/components/label"
	"picomaju/ui/components/nativeselect"
	"picomaju/ui/components/selectbox"
	"picomaju/ui/components/textarea"
	"picomaju/ui/templates/shell"
	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

templ WorkshopPage() {
	@shell.Layout("Workshop") {
		<div class="max-w-2xl mx-auto px-6 py-12 flex flex-col gap-12">
			<div>
				<h1>Workshop</h1>
				<h3 class="text-muted-foreground">Component styleguide for Picomaju UI.</h3>
			</div>
			@workshopSection("Logo") {
				<div class="flex flex-col gap-6">
					<div class="flex flex-col gap-2">
						<h5>symbol</h5>
						<img src="/static/logo-symbol.svg" alt="Picomaju symbol" class="h-16 w-auto"/>
					</div>
					<div class="flex flex-col gap-2">
						<h5>wordmark</h5>
						<img src="/static/logo-type.svg" alt="Picomaju wordmark" class="h-8 w-auto"/>
					</div>
					<div class="flex flex-col gap-2">
						<h5>stack</h5>
						<img src="/static/logo-stack.svg" alt="Picomaju stacked logo" class="h-20 w-auto"/>
					</div>
				</div>
			}
			@workshopSection("Colors") {
				<div class="flex flex-col gap-6">
					<div class="flex flex-col gap-2">
						<h4>Brand</h4>
						<div class="grid grid-cols-4 gap-3">
							@colorSwatchHex("#bf092f", "crimson")
							@colorSwatchHex("#132440", "navy-dark")
							@colorSwatchHex("#16476a", "navy")
							@colorSwatchHex("#3b9797", "teal")
						</div>
					</div>
					<div class="flex flex-col gap-2">
						<h4>Tokens — light</h4>
						<div class="grid grid-cols-4 sm:grid-cols-5 gap-3">
							<div class="flex flex-col gap-1.5">
								<div class="h-10 rounded-md border border-border bg-background"></div>
								<h5>background</h5>
							</div>
							<div class="flex flex-col gap-1.5">
								<div class="h-10 rounded-md border border-border bg-card"></div>
								<h5>card</h5>
							</div>
							<div class="flex flex-col gap-1.5">
								<div class="h-10 rounded-md border border-border bg-muted"></div>
								<h5>muted</h5>
							</div>
							<div class="flex flex-col gap-1.5">
								<div class="h-10 rounded-md bg-primary"></div>
								<h5>primary</h5>
							</div>
							<div class="flex flex-col gap-1.5">
								<div class="h-10 rounded-md bg-destructive"></div>
								<h5>destructive</h5>
							</div>
						</div>
					</div>
					<div class="flex flex-col gap-2">
						<h4>Status</h4>
						<div class="grid grid-cols-4 gap-3">
							@colorSwatchHex("#f0faf4", "ok-bg")
							@colorSwatchHex("#6dbf8e", "ok-border")
							@colorSwatchHex("#fdf0f2", "error-bg")
							@colorSwatchHex("#e87a90", "error-border")
						</div>
					</div>
				</div>
			}
			@workshopSection("Typography") {
				<div class="flex flex-col gap-8">
					<div class="flex flex-col gap-2">
						<h5>h1 — text-5xl/6xl · font-brand · font-bold · tracking-wide</h5>
						<h1>The quick brown fox</h1>
					</div>
					<div class="flex flex-col gap-2">
						<h5>h2 — text-4xl/5xl · font-brand · font-semibold · tracking-wide</h5>
						<h2>The quick brown fox</h2>
					</div>
					<div class="flex flex-col gap-2">
						<h5>h3 — text-2xl/3xl · font-brand · tracking-wide</h5>
						<h3>The quick brown fox</h3>
					</div>
					<div class="flex flex-col gap-2">
						<h5>h4 — text-lg · font-brand · font-bold · tracking-wide</h5>
						<h4>The quick brown fox</h4>
					</div>
					<div class="flex flex-col gap-2">
						<h5>h5 — text-sm · font-mono · uppercase · muted</h5>
						<h5>The quick brown fox</h5>
					</div>
					<div class="flex flex-col gap-2">
						<h5>p — text-lg/xl · muted-foreground · leading-tight</h5>
						<p>The quick brown fox jumps over the lazy dog.</p>
					</div>
				</div>
			}
			@workshopSection("Button") {
				<div class="flex flex-wrap gap-3">
					@button.Button() {
						Default
					}
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						Outline
					}
					@button.Button(button.Props{Variant: button.VariantSecondary}) {
						Secondary
					}
					@button.Button(button.Props{Variant: button.VariantDestructive}) {
						Destructive
					}
					@button.Button(button.Props{Variant: button.VariantGhost}) {
						Ghost
					}
					@button.Button(button.Props{Variant: button.VariantLink}) {
						Link
					}
				</div>
				<div class="flex flex-wrap items-center gap-3">
					@button.Button(button.Props{Size: button.SizeSm}) {
						Small
					}
					@button.Button() {
						Default
					}
					@button.Button(button.Props{Size: button.SizeLg}) {
						Large
					}
					@button.Button(button.Props{Size: button.SizeIcon}) {
						@icons.Plus(templ.Attributes{"class": "size-4"})
					}
				</div>
				<div>
					@button.Button(button.Props{FullWidth: true}) {
						Full width
					}
				</div>
			}
			@workshopSection("Icons") {
				<div class="flex flex-wrap items-center gap-4 text-foreground">
					<div class="flex flex-col items-center gap-2">
						@icons.Users(templ.Attributes{"class": "size-5"})
						<h5>Users</h5>
					</div>
					<div class="flex flex-col items-center gap-2">
						@icons.Plug(templ.Attributes{"class": "size-5"})
						<h5>Plug</h5>
					</div>
					<div class="flex flex-col items-center gap-2">
						@icons.ShieldCheck(templ.Attributes{"class": "size-5"})
						<h5>ShieldCheck</h5>
					</div>
					<div class="flex flex-col items-center gap-2">
						@icons.Plus(templ.Attributes{"class": "size-5"})
						<h5>Plus</h5>
					</div>
					<div class="flex flex-col items-center gap-2">
						@icons.Trash2(templ.Attributes{"class": "size-5"})
						<h5>Trash2</h5>
					</div>
					<div class="flex flex-col items-center gap-2">
						@icons.Pencil(templ.Attributes{"class": "size-5"})
						<h5>Pencil</h5>
					</div>
					<div class="flex flex-col items-center gap-2">
						@icons.Bot(templ.Attributes{"class": "size-5"})
						<h5>Bot</h5>
					</div>
					<div class="flex flex-col items-center gap-2">
						@icons.Settings(templ.Attributes{"class": "size-5"})
						<h5>Settings</h5>
					</div>
				</div>
				<div class="flex items-center gap-3">
					<div class="text-primary">
						@icons.Users(templ.Attributes{"class": "size-6"})
					</div>
					<div class="text-muted-foreground">
						@icons.Users(templ.Attributes{"class": "size-6"})
					</div>
					<div class="text-destructive">
						@icons.Users(templ.Attributes{"class": "size-6"})
					</div>
					<h5>color via parent text-* class</h5>
				</div>
			}
			@workshopSection("Input") {
				<div class="flex flex-col gap-4 max-w-xs">
					<div class="flex flex-col gap-1.5">
						@label.Label(label.Props{For: "demo-text"}) {
							Text input
						}
						@input.Input(input.Props{ID: "demo-text", Placeholder: "Type something…"})
					</div>
					<div class="flex flex-col gap-1.5">
						@label.Label(label.Props{For: "demo-disabled"}) {
							Disabled
						}
						@input.Input(input.Props{ID: "demo-disabled", Value: "Cannot edit this", Disabled: true})
					</div>
					<div class="flex flex-col gap-1.5">
						@label.Label(label.Props{For: "demo-error"}) {
							Error state
						}
						@input.Input(input.Props{ID: "demo-error", Value: "Bad value", HasError: true})
					</div>
				</div>
			}
			@workshopSection("Textarea") {
				<div class="flex flex-col gap-4 max-w-xs">
					<div class="flex flex-col gap-1.5">
						@label.Label(label.Props{For: "demo-ta"}) {
							Notes
						}
						@textarea.Textarea(textarea.Props{ID: "demo-ta", Placeholder: "Write something…"})
					</div>
					<div class="flex flex-col gap-1.5">
						@label.Label(label.Props{For: "demo-ta-error"}) {
							Error state
						}
						@textarea.Textarea(textarea.Props{ID: "demo-ta-error", Value: "Bad content", HasError: true})
					</div>
				</div>
			}
			@workshopSection("Alert") {
				<div class="flex flex-col gap-3">
					@alert.Alert() {
						@alert.Title() {
							Heads up
						}
						@alert.Description() {
							This is a default alert with a title and description.
						}
					}
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
						@alert.Title() {
							Something went wrong
						}
						@alert.Description() {
							Could not save your settings. Please try again.
						}
					}
				</div>
			}
			@workshopSection("Card") {
				<div class="grid grid-cols-3 gap-3">
					@card.Card() {
						@card.Content(card.ContentProps{Class: "flex flex-col items-center text-center"}) {
							<div class="text-primary size-9 mb-4" aria-hidden="true">
								@icons.Users(templ.Attributes{"class": "size-full"})
							</div>
							<h4>Staff profiles</h4>
							<div class="text-muted-foreground">Receptionist, clerk, analyst — roles you can shape.</div>
						}
					}
					@card.Card() {
						@card.Content(card.ContentProps{Class: "flex flex-col items-center text-center"}) {
							<div class="text-primary size-9 mb-4" aria-hidden="true">
								@icons.Plug(templ.Attributes{"class": "size-full"})
							</div>
							<h4>Your tools</h4>
							<div class="text-muted-foreground">WhatsApp, Shopee, Xendit, Calendar &amp; more.</div>
						}
					}
					@card.Card() {
						@card.Content(card.ContentProps{Class: "flex flex-col items-center text-center"}) {
							<div class="text-primary size-9 mb-4" aria-hidden="true">
								@icons.ShieldCheck(templ.Attributes{"class": "size-full"})
							</div>
							<h4>Enforced values</h4>
							<div class="text-muted-foreground">Tone, rules, do's and don'ts — baked in.</div>
						}
					}
				</div>
			}
			@workshopSection("Shared Components") {
				<div class="flex flex-col gap-8">
					<div class="flex flex-col gap-2">
						<h5>shell.PageHeader</h5>
						@shell.PageHeader("Section Title") {
							@button.Button(button.Props{Size: button.SizeIcon}) {
								@icons.Plus(templ.Attributes{"class": "size-4"})
							}
						}
					</div>
					<div class="flex flex-col gap-2">
						<h5>shell.Badge</h5>
						<div class="flex gap-2">
							@shell.Badge("messaging")
							@shell.Badge("commerce")
							@shell.Badge("payments")
							@shell.Badge("utilities")
						</div>
					</div>
					<div class="flex flex-col gap-2">
						<h5>shell.FormCard + shell.Field</h5>
						@shell.FormCard() {
							@shell.Field() {
								@label.Label(label.Props{For: "demo-fc"}) {
									Field label
								}
								@input.Input(input.Props{ID: "demo-fc", Placeholder: "Value…"})
							}
						}
					</div>
					<div class="flex flex-col gap-2">
						<h5>shell.RowList + shell.RowItem + shell.RowActions</h5>
						@shell.RowList() {
							@shell.RowItem() {
								<div class="flex-1 min-w-0 flex flex-col gap-0.5">
									<span class="text-sm font-brand font-semibold text-foreground">Tool name</span>
									<span class="text-xs text-muted-foreground font-mono">tool_id</span>
								</div>
								@shell.Badge("messaging")
								@shell.RowActions("/edit", "/delete", "tool")
							}
						}
					</div>
					<div class="flex flex-col gap-2">
						<h5>shell.EmptyState</h5>
						@shell.EmptyState(
							"Nothing here yet",
							"This is the empty state shown when there are no items to display.",
							"/",
							"Create your first item",
						)
					</div>
				</div>
			}
			@workshopSection("Chat Bubbles") {
				<div class="flex flex-col gap-2">
					<div class="flex justify-end">
						<div class="max-w-[80%] bg-blue-600 text-blue-50 rounded-2xl rounded-br-sm px-4 py-2.5">
							<p class="text-sm whitespace-pre-wrap">Hey, can you check the order status for customer #1042?</p>
							<p class="text-[0.625rem] text-blue-200 mt-1 text-right">14:32</p>
						</div>
					</div>
					<div class="flex justify-start gap-2">
						<div class="size-7 shrink-0 rounded-lg bg-primary/15 flex items-center justify-center mt-1">
							@icons.Bot(templ.Attributes{"class": "size-3.5 text-primary"})
						</div>
						<div class="max-w-[80%] bg-primary/10 border border-primary/20 rounded-2xl rounded-bl-sm px-4 py-2.5">
							<p class="text-sm whitespace-pre-wrap text-foreground">Order #1042 is in transit. Expected delivery: Apr 29.</p>
							<p class="text-[0.625rem] text-primary/60 mt-1">14:32</p>
						</div>
					</div>
				</div>
			}
			@workshopSection("Theme") {
				<div class="flex items-center gap-3">
					@shell.ThemeToggle()
					<h5>sidebar footer toggle · localStorage key: theme</h5>
				</div>
			}
			@workshopSection("Native Select") {
				<div class="flex flex-col gap-4 max-w-xs">
					<div class="flex flex-col gap-1.5">
						@label.Label(label.Props{For: "lang-demo"}) {
							Language / Bahasa
						}
						@nativeselect.Select(nativeselect.Props{ID: "lang-demo"}) {
							<option>English</option>
							<option>Bahasa Indonesia</option>
						}
					</div>
					<div class="flex flex-col gap-1.5">
						@label.Label(label.Props{For: "lang-demo-err"}) {
							Error state
						}
						@nativeselect.Select(nativeselect.Props{ID: "lang-demo-err", HasError: true}) {
							<option>English</option>
							<option>Bahasa Indonesia</option>
						}
					</div>
				</div>
			}
			@workshopSection("SelectBox") {
				@selectbox.Script()
				<div class="flex flex-col gap-4 max-w-xs">
					<div class="flex flex-col gap-1.5">
						@label.Label(label.Props{For: "sb-demo"}) {
							Status
						}
						@selectbox.SelectBox(selectbox.Props{ID: "sb-demo"}) {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "status"}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: "Select status…"})
							}
							@selectbox.Content() {
								@selectbox.Group() {
									@selectbox.Item(selectbox.ItemProps{Value: "active"}) {
										Active
									}
									@selectbox.Item(selectbox.ItemProps{Value: "inactive"}) {
										Inactive
									}
									@selectbox.Item(selectbox.ItemProps{Value: "pending"}) {
										Pending
									}
								}
							}
						}
					</div>
					<div class="flex flex-col gap-1.5">
						@label.Label(label.Props{For: "sb-multi"}) {
							Tags (multi-select)
						}
						@selectbox.SelectBox(selectbox.Props{ID: "sb-multi", Multiple: true}) {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "tags", Multiple: true, ShowPills: true}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: "Pick tags…", Multiple: true})
							}
							@selectbox.Content() {
								@selectbox.Group() {
									@selectbox.Item(selectbox.ItemProps{Value: "messaging"}) {
										Messaging
									}
									@selectbox.Item(selectbox.ItemProps{Value: "commerce"}) {
										Commerce
									}
									@selectbox.Item(selectbox.ItemProps{Value: "payments"}) {
										Payments
									}
									@selectbox.Item(selectbox.ItemProps{Value: "utilities"}) {
										Utilities
									}
								}
							}
						}
					</div>
				</div>
			}
		</div>
	}
}

templ workshopSection(title string) {
	<section class="flex flex-col gap-4">
		<h3 class="border-b border-border pb-2">{ title }</h3>
		{ children... }
	</section>
}

templ colorSwatchHex(hex, name string) {
	<div class="flex flex-col gap-1.5">
		<div class="h-10 rounded-md border border-border" style={ "background-color: " + hex }></div>
		<h5>{ name }</h5>
	</div>
}
