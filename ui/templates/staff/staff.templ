package stafftpl

import (
	"picomaju/internal/chat"
	"picomaju/internal/staff"
	"picomaju/internal/task"
	"picomaju/internal/tool"
	"picomaju/internal/value"
	"picomaju/ui/components/alert"
	"picomaju/ui/components/button"
	"picomaju/ui/components/input"
	"picomaju/ui/components/label"
	"picomaju/ui/templates/shell"
	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

// ─── Staff list (home page at /) ─────────────────────────────────────────────
templ StaffListPage(members []staff.Staff, nd shell.NavData) {
	@shell.AppLayout("Staff", nd, staffListSidebarNav(members)) {
		@shell.PageHeader("Staff") {
			@button.Button(button.Props{Href: "/staff/new", Size: button.SizeIcon}) {
				@icons.Plus(templ.Attributes{"class": "size-4"})
			}
		}
		if len(members) == 0 {
			@shell.EmptyState(
				"No staff profiles",
				"A staff profile is an agent that represents a person or role — like a receptionist or billing clerk.",
				"/staff/new",
				"Create your first staff",
			)
		} else {
			@staffDashboard(members)
		}
	}
}

templ staffListSidebarNav(members []staff.Staff) {
	<nav class="flex flex-col gap-2 py-2 flex-1">
		for _, m := range members {
			@shell.SidebarItem("/staff/"+m.ID, m.Label, m.ID, "") {
				if m.Icon == "" {
					@icons.UserRound(templ.Attributes{"class": "size-4"})
				} else {
					@staffIcon(m.Icon, "")
				}
			}
		}
	</nav>
}

templ staffDashboard(members []staff.Staff) {
	<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
		for _, m := range members {
			<a href={ templ.SafeURL("/staff/" + m.ID) } class="bg-card rounded-lg border border-border p-4 flex flex-col gap-3 hover:border-primary/50 transition-colors">
				<div class="flex items-center gap-3">
					<div class="size-9 shrink-0 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-brand font-semibold text-sm">
						@staffIcon(m.Icon, m.Label)
					</div>
					<div class="flex-1 min-w-0">
						<div class="flex items-center gap-2">
							<span class="text-sm font-brand font-semibold text-foreground truncate">{ m.Label }</span>
							if m.Active {
								<span class="shrink-0 inline-flex items-center px-1.5 py-0.5 rounded-full text-[0.625rem] font-mono uppercase tracking-wide bg-green-500/10 text-green-600 dark:text-green-400">Active</span>
							} else {
								<span class="shrink-0 inline-flex items-center px-1.5 py-0.5 rounded-full text-[0.625rem] font-mono uppercase tracking-wide bg-muted text-muted-foreground">Inactive</span>
							}
						</div>
						if m.Description != "" {
							<p class="text-xs text-muted-foreground truncate mt-0.5">{ m.Description }</p>
						}
					</div>
				</div>
				<div class="flex gap-4 text-xs font-mono text-muted-foreground">
					<span>{ shell.CountWord(len(m.Tasks), "task", "tasks") }</span>
					<span>{ shell.CountWord(len(m.ValueCategories)+len(m.Values), "value ref", "value refs") }</span>
				</div>
			</a>
		}
	</div>
}

// ─── Staff detail page ───────────────────────────────────────────────────────
templ StaffDetailPage(m *staff.Staff, tasks []task.Task, tools []tool.Tool, values []*value.Value, cats []value.Category, nd shell.NavData, section string, formErr string, chats []chat.Chat, compiled bool, licensed bool, running bool) {
	@shell.AppLayout(m.Label, nd, staffSidebarNav(m, section, chats)) {
		<div class="flex items-center gap-3">
			<div class="size-9 shrink-0 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-brand font-semibold text-sm">
				@staffIcon(m.Icon, m.Label)
			</div>
			<h3 class="font-brand font-bold text-foreground">{ m.Label }</h3>
		</div>
		if formErr != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				@alert.Description() {
					{ formErr }
				}
			}
		}
		switch section {
			case "profile":
				@staffProfileSection(m)
			case "values":
				@staffValuesSection(m, values, cats)
			case "tools":
				@staffToolsSection(m, tasks, tools)
			case "tasks":
				@staffTasksSection(m, tasks)
			default:
				@staffOverviewSection(m, tasks, tools, compiled, licensed, running)
		}
	}
}

templ staffSidebarNav(m *staff.Staff, section string, chats []chat.Chat) {
	<nav class="flex flex-col gap-2 py-2 flex-1">
		@shell.SidebarItem("/staff/"+m.ID+"?s=overview", "Overview", "overview", section) {
			@icons.LayoutDashboard(templ.Attributes{"class": "size-4"})
		}
		@shell.SidebarItem("/staff/"+m.ID+"?s=profile", "Profile", "profile", section) {
			@icons.UserRound(templ.Attributes{"class": "size-4"})
		}
		@shell.SidebarItem("/staff/"+m.ID+"?s=values", "Values", "values", section) {
			@icons.Star(templ.Attributes{"class": "size-4"})
		}
		@shell.SidebarItem("/staff/"+m.ID+"?s=tools", "Tools", "tools", section) {
			@icons.Wrench(templ.Attributes{"class": "size-4"})
		}
		@shell.SidebarItem("/staff/"+m.ID+"?s=tasks", "Tasks", "tasks", section) {
			@icons.ClipboardList(templ.Attributes{"class": "size-4"})
		}
		<div class="mx-2 my-1 border-t border-sidebar-border"></div>
		<form method="post" action={ templ.SafeURL("/staff/" + m.ID + "/chats") } class="px-2">
			<button
				type="submit"
				class="w-full flex items-center gap-2 px-1 py-0.5 rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 cursor-pointer"
			>
				<span class="size-8 shrink-0 flex items-center justify-center">
					@icons.MessageSquarePlus(templ.Attributes{"class": "size-4"})
				</span>
				<span data-sidebar-label>New Chat</span>
			</button>
		</form>
		for _, c := range chats {
			@shell.SidebarItem("/staff/"+m.ID+"/chats/"+c.ID, c.Title, c.ID, section) {
				@icons.MessageSquare(templ.Attributes{"class": "size-4"})
			}
		}
	</nav>
	<div class="py-2 border-t border-sidebar-border shrink-0">
		@shell.SidebarItem("/", "All Staff", "", section) {
			@icons.ArrowLeft(templ.Attributes{"class": "size-4"})
		}
	</div>
}

// ─── Overview section ─────────────────────────────────────────────────────────
templ staffOverviewSection(m *staff.Staff, tasks []task.Task, tools []tool.Tool, compiled bool, licensed bool, running bool) {
	<h2 class="text-base font-brand font-semibold text-foreground">Overview</h2>
	<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
		@staffStatCardLink("Status", staffActiveLabel(m.Active), "/staff/"+m.ID+"?s=profile") {
			@icons.Activity(templ.Attributes{"class": "size-4 text-muted-foreground"})
		}
		@staffStatCardLink("Values", shell.CountWord(len(m.ValueCategories)+len(m.Values), "ref", "refs"), "/staff/"+m.ID+"?s=values") {
			@icons.Star(templ.Attributes{"class": "size-4 text-muted-foreground"})
		}
		@staffStatCardLink("Tools", shell.CountWord(staffToolCount(m, tasks), "linked", "linked"), "/staff/"+m.ID+"?s=tools") {
			@icons.Wrench(templ.Attributes{"class": "size-4 text-muted-foreground"})
		}
		@staffStatCardLink("Tasks", shell.CountWord(len(m.Tasks), "assigned", "assigned"), "/staff/"+m.ID+"?s=tasks") {
			@icons.ClipboardList(templ.Attributes{"class": "size-4 text-muted-foreground"})
		}
	</div>
	<div class="bg-card rounded-lg border border-border p-5 flex flex-col gap-3">
		<div class="flex items-center justify-between">
			<h5 class="text-sm font-brand font-semibold text-foreground">Directives</h5>
			if compiled {
				<span class="text-xs font-mono text-green-600 dark:text-green-400">Compiled</span>
			}
		</div>
		if compiled {
			<p class="text-sm text-muted-foreground">Workspace files (AGENT.md, SOUL.md, USER.md) written successfully.</p>
		} else {
			<p class="text-sm text-muted-foreground">Compile this agent's profile into workspace identity files for PicoClaw.</p>
		}
		<form method="post" action={ templ.SafeURL("/staff/" + m.ID + "/compile") }>
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
				@icons.FileCode(templ.Attributes{"class": "size-3.5"})
				if compiled {
					Recompile
				} else {
					Compile
				}
			}
		</form>
	</div>
	<div class="bg-card rounded-lg border border-border p-5 flex flex-col gap-3">
		<div class="flex items-center justify-between">
			<h5 class="text-sm font-brand font-semibold text-foreground">Runtime</h5>
			if running {
				<span class="text-xs font-mono text-green-600 dark:text-green-400">Running</span>
			}
		</div>
		if !licensed {
			<p class="text-sm text-muted-foreground">Activate to run this agent with live LLM calls via PicoClaw.</p>
			@button.Button(button.Props{Href: "/license", Variant: button.VariantOutline, Size: button.SizeSm}) {
				@icons.Zap(templ.Attributes{"class": "size-3.5"})
				Upgrade to Activate
			}
		} else if running {
			<p class="text-sm text-muted-foreground">PicoClaw agent process is active.</p>
			<form method="post" action={ templ.SafeURL("/staff/" + m.ID + "/deactivate") }>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
					@icons.StopCircle(templ.Attributes{"class": "size-3.5"})
					Stop
				}
			</form>
		} else {
			<p class="text-sm text-muted-foreground">Start the PicoClaw agent process to enable live LLM calls.</p>
			<form method="post" action={ templ.SafeURL("/staff/" + m.ID + "/activate") }>
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
					@icons.Play(templ.Attributes{"class": "size-3.5"})
					Activate
				}
			</form>
		}
	</div>
	<div class="bg-card rounded-lg border border-border p-5 flex flex-col gap-3">
		<div class="flex items-center justify-between">
			<h5 class="text-sm font-brand font-semibold text-foreground">Activity & Reports</h5>
			<span class="text-xs font-mono text-muted-foreground">Coming soon</span>
		</div>
		<p class="text-sm text-muted-foreground">Agent activity logs, conversation summaries, and performance analytics will appear here.</p>
	</div>
}

templ staffStatCard(label, value string) {
	<div class="bg-card rounded-lg border border-border p-4 flex flex-col gap-2">
		<div class="flex items-center justify-between">
			<span class="text-xs font-mono text-muted-foreground uppercase tracking-wide">{ label }</span>
			{ children... }
		</div>
		<span class="text-sm font-brand font-semibold text-foreground">{ value }</span>
	</div>
}

templ staffStatCardLink(label, value, href string) {
	<a href={ templ.SafeURL(href) } class="bg-card rounded-lg border border-border p-4 flex flex-col gap-2 hover:border-primary/50 transition-colors">
		<div class="flex items-center justify-between">
			<span class="text-xs font-mono text-muted-foreground uppercase tracking-wide">{ label }</span>
			{ children... }
		</div>
		<span class="text-sm font-brand font-semibold text-foreground">{ value }</span>
	</a>
}

// ─── Profile section ──────────────────────────────────────────────────────────
templ staffProfileSection(m *staff.Staff) {
	<h2 class="text-base font-brand font-semibold text-foreground">Profile</h2>
	<form method="post" action={ templ.SafeURL("/staff/" + m.ID + "/profile") } class="flex flex-col gap-5">
		@shell.FormCard() {
			<div class="flex flex-col gap-1.5">
				<span class="text-xs font-mono text-muted-foreground">ID</span>
				<span class="text-sm font-mono text-foreground">{ m.ID }</span>
			</div>
			@shell.Field() {
				@label.Label(label.Props{For: "staff-label"}) {
					Label
				}
				@input.Input(input.Props{ID: "staff-label", Name: "label", Value: m.Label, Placeholder: "Support Agent", Required: true})
			}
			@shell.Field() {
				@label.Label(label.Props{For: "staff-description"}) {
					Description
				}
				@input.Input(input.Props{ID: "staff-description", Name: "description", Value: m.Description, Placeholder: "Handles customer support and inquiries"})
			}
			<div class="flex flex-col gap-1.5">
				<span class="text-sm font-medium text-foreground">Active</span>
				<label class="flex items-center gap-3 p-3 rounded-lg border border-border cursor-pointer transition-colors hover:bg-muted has-[:checked]:border-primary has-[:checked]:bg-primary/5 w-fit">
					<input
						type="checkbox"
						name="active"
						value="on"
						checked?={ m.Active }
						class="sr-only"
					/>
					<span class="text-sm text-foreground">Enable this staff member</span>
				</label>
			</div>
		}
		<div class="bg-card rounded-lg border border-border p-5 sm:p-6 flex flex-col gap-4">
			<div class="flex flex-col gap-0.5">
				<span class="text-sm font-medium text-foreground">Icon</span>
				<p class="text-xs text-muted-foreground">Represents this staff member across the app.</p>
			</div>
			@staffIconPicker(m.Icon, m.Label)
		</div>
		@button.Button(button.Props{Type: button.TypeSubmit}) {
			Save
		}
	</form>
}

// ─── Values section ───────────────────────────────────────────────────────────
templ staffValuesSection(m *staff.Staff, values []*value.Value, cats []value.Category) {
	@shell.PageHeader("Values") {
		@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeIcon, Attributes: templ.Attributes{"onclick": "document.getElementById('staff-values-dialog').showModal()"}}) {
			@icons.Plus(templ.Attributes{"class": "size-4"})
		}
	}
	if len(m.ValueCategories) == 0 && len(m.Values) == 0 {
		if len(cats) == 0 {
			<p class="text-sm text-muted-foreground">No values created yet. <a href="/values/new" class="text-primary underline underline-offset-2">Add a value</a> first.</p>
		} else {
			<p class="text-sm text-muted-foreground">No values assigned. Tap + to add.</p>
		}
	} else {
		@shell.RowList() {
			for _, cat := range cats {
				if shell.IncludesStr(m.ValueCategories, cat.ID) {
					@shell.RowItem() {
						<span class="size-8 shrink-0 flex items-center justify-center text-muted-foreground">
							@shell.ValueCatIcon(cat.ID)
						</span>
						<span class="flex-1 min-w-0 text-sm font-brand font-semibold text-foreground truncate">{ cat.Label }</span>
						@shell.Badge("all")
						<form method="post" action={ templ.SafeURL("/staff/" + m.ID + "/value-cats/" + cat.ID + "/remove") }>
							<button type="submit" class="inline-flex size-8 shrink-0 items-center justify-center rounded text-muted-foreground hover:text-destructive hover:bg-destructive/10 transition-colors cursor-pointer" aria-label={ "Remove " + cat.Label }>
								@icons.X(templ.Attributes{"class": "size-3.5"})
							</button>
						</form>
					}
				}
			}
			for _, v := range values {
				if shell.IncludesStr(m.Values, v.ID) {
					@shell.RowItem() {
						<span class="size-8 shrink-0 flex items-center justify-center text-muted-foreground">
							@icons.FileText(templ.Attributes{"class": "size-4"})
						</span>
						<span class="flex-1 min-w-0 text-sm font-brand font-semibold text-foreground truncate">{ v.Title }</span>
						@shell.Badge(shell.CategoryLabel(cats, v.Category))
						<form method="post" action={ templ.SafeURL("/staff/" + m.ID + "/values/" + v.ID + "/remove") }>
							<button type="submit" class="inline-flex size-8 shrink-0 items-center justify-center rounded text-muted-foreground hover:text-destructive hover:bg-destructive/10 transition-colors cursor-pointer" aria-label={ "Remove " + v.Title }>
								@icons.X(templ.Attributes{"class": "size-3.5"})
							</button>
						</form>
					}
				}
			}
		}
	}
	<dialog id="staff-values-dialog" class="w-full w-[calc(100%-3rem)] max-w-2xl rounded-xl m-auto">
		<div class="bg-card rounded-xl border border-border flex flex-col" style="max-height: 80dvh">
			<div class="flex items-center justify-between px-4 py-3 border-b border-border shrink-0">
				<span class="text-sm font-brand font-semibold text-foreground">Values</span>
				<button type="button" onclick="document.getElementById('staff-values-dialog').close()" class="inline-flex size-8 items-center justify-center rounded text-muted-foreground hover:text-foreground hover:bg-muted transition-colors cursor-pointer" aria-label="Close">
					@icons.X(templ.Attributes{"class": "size-4"})
				</button>
			</div>
			<form method="post" action={ templ.SafeURL("/staff/" + m.ID + "/values") } class="flex flex-col min-h-0">
				<div class="overflow-y-auto flex-1 flex flex-col gap-4 px-4 py-4">
					for _, cat := range cats {
						<div class="flex flex-col gap-2">
							<label class="flex items-center gap-3 p-3 rounded-lg border border-border cursor-pointer bg-secondary/30 transition-colors hover:bg-secondary has-[:checked]:border-primary has-[:checked]:bg-primary/5">
								<input type="checkbox" name="value_categories" value={ cat.ID } checked?={ shell.IncludesStr(m.ValueCategories, cat.ID) } class="sr-only"/>
								<span class="text-sm font-brand font-semibold text-foreground">{ cat.Label }</span>
								@shell.Badge("all")
							</label>
							@staffValuePicker(cat.ID, values, m.Values)
						</div>
					}
				</div>
				<div class="shrink-0 px-4 py-3 border-t border-border">
					@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
						Save
					}
				</div>
			</form>
		</div>
	</dialog>
}

// ─── Tools section ────────────────────────────────────────────────────────────
templ staffToolsSection(m *staff.Staff, tasks []task.Task, tools []tool.Tool) {
	<h2 class="text-base font-brand font-semibold text-foreground">Tools</h2>
	if staffToolCount(m, tasks) == 0 {
		<p class="text-sm text-muted-foreground">
			No tools linked yet. Assign tasks with tools in the
			<a href={ templ.SafeURL("/staff/" + m.ID + "?s=tasks") } class="text-primary underline underline-offset-2">Tasks</a>
			section.
		</p>
	} else {
		<div class="flex flex-col divide-y divide-border rounded-lg border border-border overflow-hidden bg-card">
			for _, t := range tasks {
				if shell.IncludesStr(m.Tasks, t.ID) {
					for _, tl := range tools {
						if shell.IncludesStr(t.Tools, tl.ID) {
							<div class="flex items-center gap-3 px-4 py-3">
								<div class="size-8 shrink-0 rounded-md bg-muted flex items-center justify-center">
									@icons.Wrench(templ.Attributes{"class": "size-3.5 text-muted-foreground"})
								</div>
								<div class="flex-1 min-w-0 flex flex-col gap-0.5">
									<span class="text-sm font-brand font-semibold text-foreground">{ tl.Label }</span>
									<span class="text-xs text-muted-foreground font-mono">via { t.Label }</span>
								</div>
								@shell.Badge(tl.Type)
							</div>
						}
					}
				}
			}
		</div>
	}
}

// ─── Tasks section ────────────────────────────────────────────────────────────
templ staffTasksSection(m *staff.Staff, tasks []task.Task) {
	@shell.PageHeader("Tasks") {
		@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeIcon, Attributes: templ.Attributes{"onclick": "document.getElementById('staff-tasks-dialog').showModal()"}}) {
			@icons.Plus(templ.Attributes{"class": "size-4"})
		}
	}
	if len(m.Tasks) == 0 {
		if len(tasks) == 0 {
			<p class="text-sm text-muted-foreground">No tasks created yet. <a href="/tasks/new" class="text-primary underline underline-offset-2">Add a task</a> first.</p>
		} else {
			<p class="text-sm text-muted-foreground">No tasks assigned. Tap + to add.</p>
		}
	} else {
		@shell.RowList() {
			for _, t := range tasks {
				if shell.IncludesStr(m.Tasks, t.ID) {
					@shell.RowItem() {
						<span class="size-8 shrink-0 flex items-center justify-center text-muted-foreground">
							@icons.ClipboardList(templ.Attributes{"class": "size-4"})
						</span>
						<div class="flex-1 min-w-0 flex flex-col gap-0.5">
							<span class="text-sm font-brand font-semibold text-foreground truncate">{ t.Label }</span>
							if t.Description != "" {
								<span class="text-xs text-muted-foreground truncate">{ t.Description }</span>
							}
						</div>
						<span class="hidden sm:block text-xs text-muted-foreground font-mono shrink-0">{ shell.CountWord(len(t.Tools), "tool", "tools") }</span>
						<form method="post" action={ templ.SafeURL("/staff/" + m.ID + "/tasks/" + t.ID + "/remove") }>
							<button type="submit" class="inline-flex size-8 shrink-0 items-center justify-center rounded text-muted-foreground hover:text-destructive hover:bg-destructive/10 transition-colors cursor-pointer" aria-label={ "Remove " + t.Label }>
								@icons.X(templ.Attributes{"class": "size-3.5"})
							</button>
						</form>
					}
				}
			}
		}
	}
	<dialog id="staff-tasks-dialog" class="w-full w-[calc(100%-3rem)] max-w-2xl rounded-xl m-auto">
		<div class="bg-card rounded-xl border border-border flex flex-col" style="max-height: 80dvh">
			<div class="flex items-center justify-between px-4 py-3 border-b border-border shrink-0">
				<span class="text-sm font-brand font-semibold text-foreground">Tasks</span>
				<button type="button" onclick="document.getElementById('staff-tasks-dialog').close()" class="inline-flex size-8 items-center justify-center rounded text-muted-foreground hover:text-foreground hover:bg-muted transition-colors cursor-pointer" aria-label="Close">
					@icons.X(templ.Attributes{"class": "size-4"})
				</button>
			</div>
			<form method="post" action={ templ.SafeURL("/staff/" + m.ID + "/tasks") } class="flex flex-col min-h-0">
				<div class="overflow-y-auto flex-1 flex flex-col gap-2 px-4 py-4">
					for _, t := range tasks {
						<label class="flex items-start gap-3 p-3 rounded-lg border border-border cursor-pointer transition-colors hover:bg-muted has-[:checked]:border-primary has-[:checked]:bg-primary/5">
							<input type="checkbox" name="tasks" value={ t.ID } checked?={ shell.IncludesStr(m.Tasks, t.ID) } class="sr-only"/>
							<div class="flex flex-col gap-0.5 min-w-0 flex-1">
								<span class="text-sm font-brand font-semibold text-foreground">{ t.Label }</span>
								if t.Description != "" {
									<span class="text-xs text-muted-foreground">{ t.Description }</span>
								}
							</div>
							<span class="text-xs text-muted-foreground font-mono shrink-0 mt-0.5">{ shell.CountWord(len(t.Tools), "tool", "tools") }</span>
						</label>
					}
				</div>
				<div class="shrink-0 px-4 py-3 border-t border-border">
					@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
						Save
					}
				</div>
			</form>
		</div>
	</dialog>
}

// ─── New staff form (/staff/new) ──────────────────────────────────────────────
templ StaffFormPage(m *staff.Staff, nd shell.NavData, formErr string) {
	@shell.AppLayout("New Staff", nd, shell.EmptySidebarNav()) {
		@shell.PageHeader("New Staff") {
			@button.Button(button.Props{Href: "/", Variant: button.VariantGhost, Size: button.SizeSm}) {
				Cancel
			}
		}
		if formErr != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				@alert.Description() {
					{ formErr }
				}
			}
		}
		<form method="post" action="/staff" class="flex flex-col gap-5">
			@shell.FormCard() {
				@shell.Field() {
					@label.Label(label.Props{For: "id"}) {
						ID
					}
					@input.Input(input.Props{ID: "id", Name: "id", Value: m.ID, Placeholder: "support_agent", Required: true})
				}
				@shell.Field() {
					@label.Label(label.Props{For: "staff-label"}) {
						Label
					}
					@input.Input(input.Props{ID: "staff-label", Name: "label", Value: m.Label, Placeholder: "Support Agent", Required: true})
				}
				@shell.Field() {
					@label.Label(label.Props{For: "staff-description"}) {
						Description
					}
					@input.Input(input.Props{ID: "staff-description", Name: "description", Value: m.Description, Placeholder: "Handles customer support and inquiries"})
				}
			}
			<div class="bg-card rounded-lg border border-border p-5 sm:p-6 flex flex-col gap-4">
				<div class="flex flex-col gap-0.5">
					<span class="text-sm font-medium text-foreground">Icon</span>
					<p class="text-xs text-muted-foreground">Represents this staff member across the app.</p>
				</div>
				@staffIconPicker(m.Icon, m.Label)
			</div>
			@button.Button(button.Props{Type: button.TypeSubmit}) {
				Create
			}
		</form>
	}
}

// ─── Icon picker ──────────────────────────────────────────────────────────────
templ staffIconPicker(selected, lbl string) {
	<div data-icon-picker class="relative w-fit">
		<button
			type="button"
			class="flex items-center gap-2 px-2 py-2 rounded-lg border border-border hover:border-muted-foreground bg-background transition-colors"
			onclick="this.closest('[data-icon-picker]').querySelector('[data-icon-panel]').classList.toggle('hidden')"
		>
			<div class="size-9 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-brand font-semibold text-sm shrink-0">
				<span data-icon-preview="" class={ templ.KV("hidden", selected != "") }>{ staffInitials(lbl) }</span>
				for _, opt := range staffIconOptions() {
					<span data-icon-preview={ opt } class={ templ.KV("hidden", selected != opt) }>
						@staffIcon(opt, "")
					</span>
				}
			</div>
			@icons.ChevronDown(templ.Attributes{"class": "size-3.5 text-muted-foreground"})
		</button>
		<div
			data-icon-panel
			class="hidden absolute z-50 top-full left-0 mt-1.5 bg-popover border border-border rounded-xl shadow-lg p-3"
		>
			<div class="flex flex-wrap gap-1.5 w-72 max-h-52 overflow-y-auto">
				<label
					title="Initials"
					class={
						"size-9 rounded-lg flex items-center justify-center cursor-pointer transition-all font-brand font-semibold text-sm ring-offset-background",
						templ.KV("bg-primary text-primary-foreground ring-2 ring-primary ring-offset-2", selected == ""),
						templ.KV("bg-primary/10 text-primary hover:bg-primary hover:text-primary-foreground", selected != ""),
					}
				>
					<input type="radio" name="icon" value="" checked?={ selected == "" } class="sr-only"/>
					{ staffInitials(lbl) }
				</label>
				for _, opt := range staffIconOptions() {
					<label
						title={ opt }
						class={
							"size-9 rounded-lg flex items-center justify-center cursor-pointer transition-all ring-offset-background",
							templ.KV("bg-primary text-primary-foreground ring-2 ring-primary ring-offset-2", selected == opt),
							templ.KV("bg-primary/10 text-primary hover:bg-primary hover:text-primary-foreground", selected != opt),
						}
					>
						<input type="radio" name="icon" value={ opt } checked?={ selected == opt } class="sr-only"/>
						@staffIcon(opt, "")
					</label>
				}
			</div>
		</div>
	</div>
	<script>
		(function () {
			var pickers = document.querySelectorAll("[data-icon-picker]");
			document.addEventListener("click", function (e) {
				pickers.forEach(function (picker) {
					if (!picker.contains(e.target)) {
						var panel = picker.querySelector("[data-icon-panel]");
						if (panel) panel.classList.add("hidden");
					}
				});
			}, true);
			pickers.forEach(function (picker) {
				picker.querySelectorAll('input[name="icon"]').forEach(function (radio) {
					radio.addEventListener("change", function () {
						var val = this.value;
						picker.querySelectorAll("[data-icon-preview]").forEach(function (el) {
							el.classList.toggle("hidden", el.dataset.iconPreview !== val);
						});
						var panel = picker.querySelector("[data-icon-panel]");
						if (panel) panel.classList.add("hidden");
					});
				});
			});
		})();
	</script>
}

templ staffIcon(iconName, lbl string) {
	switch iconName {
		case "user":
			@icons.User(templ.Attributes{"class": "size-4"})
		case "user-round":
			@icons.UserRound(templ.Attributes{"class": "size-4"})
		case "bot":
			@icons.Bot(templ.Attributes{"class": "size-4"})
		case "headphones":
			@icons.Headphones(templ.Attributes{"class": "size-4"})
		case "phone":
			@icons.Phone(templ.Attributes{"class": "size-4"})
		case "mail":
			@icons.Mail(templ.Attributes{"class": "size-4"})
		case "calendar":
			@icons.Calendar(templ.Attributes{"class": "size-4"})
		case "clipboard":
			@icons.Clipboard(templ.Attributes{"class": "size-4"})
		case "briefcase":
			@icons.Briefcase(templ.Attributes{"class": "size-4"})
		case "calculator":
			@icons.Calculator(templ.Attributes{"class": "size-4"})
		case "cpu":
			@icons.Cpu(templ.Attributes{"class": "size-4"})
		case "database":
			@icons.Database(templ.Attributes{"class": "size-4"})
		case "globe":
			@icons.Globe(templ.Attributes{"class": "size-4"})
		case "key":
			@icons.Key(templ.Attributes{"class": "size-4"})
		case "megaphone":
			@icons.Megaphone(templ.Attributes{"class": "size-4"})
		case "message-circle":
			@icons.MessageCircle(templ.Attributes{"class": "size-4"})
		case "monitor":
			@icons.Monitor(templ.Attributes{"class": "size-4"})
		case "package":
			@icons.Package(templ.Attributes{"class": "size-4"})
		case "pencil":
			@icons.Pencil(templ.Attributes{"class": "size-4"})
		case "shield":
			@icons.Shield(templ.Attributes{"class": "size-4"})
		case "star":
			@icons.Star(templ.Attributes{"class": "size-4"})
		case "truck":
			@icons.Truck(templ.Attributes{"class": "size-4"})
		case "wrench":
			@icons.Wrench(templ.Attributes{"class": "size-4"})
		case "zap":
			@icons.Zap(templ.Attributes{"class": "size-4"})
		case "wallet":
			@icons.Wallet(templ.Attributes{"class": "size-4"})
		case "award":
			@icons.Award(templ.Attributes{"class": "size-4"})
		case "coffee":
			@icons.Coffee(templ.Attributes{"class": "size-4"})
		case "flag":
			@icons.Flag(templ.Attributes{"class": "size-4"})
		default:
			{ staffInitials(lbl) }
	}
}

templ staffValuePicker(catID string, values []*value.Value, selected []string) {
	<div class="pl-4 flex flex-col gap-1.5">
		for _, v := range values {
			if v.Category == catID {
				<label class="flex items-center gap-2.5 px-3 py-2 rounded-md cursor-pointer text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors has-[:checked]:text-foreground">
					<input
						type="checkbox"
						name="values"
						value={ v.ID }
						checked?={ shell.IncludesStr(selected, v.ID) }
						class="sr-only"
					/>
					{ v.Title }
				</label>
			}
		}
	</div>
}
