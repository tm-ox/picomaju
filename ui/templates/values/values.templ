package valuestpl

import (
	"fmt"
	"picomaju/internal/value"
	"picomaju/ui/components/alert"
	"picomaju/ui/components/button"
	"picomaju/ui/components/input"
	"picomaju/ui/components/label"
	"picomaju/ui/templates/shell"
	icons "github.com/bryanvaz/go-templ-lucide-icons"
)

templ valueSidebarNav(cats []value.Category, activeCat string) {
	<nav class="flex flex-col gap-2 py-2 flex-1">
		@shell.SidebarItem("/values", "All", "", activeCat) {
			@icons.Star(templ.Attributes{"class": "size-4"})
		}
		for _, c := range cats {
			@shell.SidebarItem("/values?cat="+c.ID, c.Label, c.ID, activeCat) {
				@shell.ValueCatIcon(c.ID)
			}
		}
	</nav>
}

templ ValueListPage(values []*value.Value, cats []value.Category, nd shell.NavData, activeCat string) {
	@shell.AppLayout("Values", nd, valueSidebarNav(cats, activeCat)) {
		@shell.PageHeader(func() string {
			if activeCat != "" {
				return shell.CategoryLabel(cats, activeCat)
			}
			return "Values"
		}()) {
			@button.Button(button.Props{Href: "/values/new", Size: button.SizeIcon}) {
				@icons.Plus(templ.Attributes{"class": "size-4"})
			}
		}
		if len(values) == 0 {
			@shell.EmptyState(
				"No values yet",
				"Values are rules your AI agents follow — tone, do's, don'ts, escalation triggers.",
				"/values/new",
				"Create your first value",
			)
		} else if activeCat == "" {
			for _, g := range groupValuesByCat(cats, values) {
				@shell.ListSection(g.Cat.Label) {
					for _, v := range g.Values {
						@shell.RowItem() {
							<div class="flex-1 min-w-0 flex flex-col gap-0.5">
								<span class="text-sm font-brand font-semibold text-foreground truncate">{ v.Title }</span>
								<span class="text-xs text-muted-foreground font-mono">{ v.ID }</span>
							</div>
							<div class="hidden sm:flex items-center gap-2 shrink-0">
								<span class="text-xs text-muted-foreground font-mono">p{ fmt.Sprintf("%d", v.Priority) }</span>
							</div>
							@shell.RowActions("/values/"+v.ID+"/edit", "/values/"+v.ID+"/delete", "value")
						}
					}
				}
			}
		} else {
			@shell.RowList() {
				for _, v := range values {
					@shell.RowItem() {
						<div class="flex-1 min-w-0 flex flex-col gap-0.5">
							<span class="text-sm font-brand font-semibold text-foreground truncate">{ v.Title }</span>
							<span class="text-xs text-muted-foreground font-mono">{ v.ID }</span>
						</div>
						<div class="hidden sm:flex items-center gap-2 shrink-0">
							@shell.Badge(shell.CategoryLabel(cats, v.Category))
							<span class="text-xs text-muted-foreground font-mono">p{ fmt.Sprintf("%d", v.Priority) }</span>
						</div>
						@shell.RowActions("/values/"+v.ID+"/edit", "/values/"+v.ID+"/delete", "value")
					}
				}
			}
		}
	}
}

templ ValueFormPage(v *value.Value, cats []value.Category, nd shell.NavData, isNew bool, formErr string) {
	@shell.AppLayout(shell.FormTitle("Value", isNew), nd, shell.EmptySidebarNav()) {
		@shell.PageHeader(shell.FormTitle("Value", isNew)) {
			@button.Button(button.Props{Href: "/values", Variant: button.VariantGhost, Size: button.SizeSm}) {
				Cancel
			}
		}
		if formErr != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				@alert.Description() {
					{ formErr }
				}
			}
		}
		<form method="post" action={ templ.SafeURL(shell.FormAction("/values", v.ID, isNew)) } class="bg-card rounded-lg border border-border p-5 sm:p-6 flex flex-col gap-5">
			@shell.Field() {
				@label.Label(label.Props{For: "id"}) {
					ID
				}
				if isNew {
					@input.Input(input.Props{ID: "id", Name: "id", Value: v.ID, Placeholder: "tone_of_voice", Required: true})
				} else {
					@input.Input(input.Props{ID: "id", Name: "id", Value: v.ID, Disabled: true})
				}
			}
			@shell.Field() {
				@label.Label(label.Props{For: "title"}) {
					Title
				}
				@input.Input(input.Props{ID: "title", Name: "title", Value: v.Title, Required: true})
			}
			@shell.Field() {
				@label.Label(label.Props{For: "category"}) {
					Category
				}
				<select id="category" name="category" required>
					<option value="">— select —</option>
					for _, c := range cats {
						<option value={ c.ID } selected?={ v.Category == c.ID }>{ c.Label }</option>
					}
				</select>
			}
			@shell.Field() {
				@label.Label(label.Props{For: "version"}) {
					Version
				}
				@input.Input(input.Props{ID: "version", Name: "version", Value: fmt.Sprintf("%d", v.Version), Type: "number", Required: true, Attributes: templ.Attributes{"min": "1"}})
			}
			@shell.Field() {
				@label.Label(label.Props{For: "priority"}) {
					Priority (0–100)
				}
				@input.Input(input.Props{ID: "priority", Name: "priority", Value: fmt.Sprintf("%d", v.Priority), Type: "number", Required: true, Attributes: templ.Attributes{"min": "0", "max": "100"}})
			}
			@shell.Field() {
				@label.Label(label.Props{For: "body"}) {
					Directive
				}
				<textarea id="body" name="body" rows="8">{ v.Body }</textarea>
			}
			<div class="flex items-center gap-3 pt-1">
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Save
				}
				if !isNew {
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantOutline,
						Attributes: templ.Attributes{
							"data-on-click": fmt.Sprintf("@post('/values/%s/validate-stream')", v.ID),
						},
					}) {
						Validate
					}
				}
			</div>
		</form>
		if !isNew {
			<div id="validation-result"></div>
		}
	}
}

templ ValidationFragment(res value.ValidationResult) {
	<div id="validation-result" class="flex flex-col gap-3">
		if res.Valid {
			@alert.Alert() {
				@alert.Title() {
					Valid
				}
				@alert.Description() {
					All required fields are present and in range.
				}
			}
		} else {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				@alert.Title() {
					Validation failed
				}
				@alert.Description() {
					<ul class="list-disc list-inside mt-1 flex flex-col gap-0.5">
						for _, e := range res.Errors {
							<li>{ e.Field }: { e.Message }</li>
						}
					</ul>
				}
			}
		}
		if len(res.Warnings) > 0 {
			@alert.Alert() {
				@alert.Title() {
					Warnings
				}
				@alert.Description() {
					<ul class="list-disc list-inside mt-1 flex flex-col gap-0.5">
						for _, w := range res.Warnings {
							<li>{ w }</li>
						}
					</ul>
				}
			}
		}
	</div>
}
