package templates

import (
	icons "github.com/bryanvaz/go-templ-lucide-icons"
	"picomaju/ui/components/alert"
	"picomaju/ui/components/button"
	"picomaju/ui/components/card"
	"picomaju/ui/components/label"
)

type welcomeFeature struct {
	Icon  templ.Component
	Title string
	Body  string
}

var welcomeFeatures = []welcomeFeature{
	{
		Icon:  icons.ShieldCheck(templ.Attributes{"class": "size-full"}),
		Title: "Enforced values",
		Body:  "Tone, rules, do's and don'ts — baked in.",
	},
	{
		Icon:  icons.Plug(templ.Attributes{"class": "size-full"}),
		Title: "Your tools",
		Body:  "WhatsApp, Shopee, Xendit, Calendar & more.",
	},
	{
		Icon:  icons.Users(templ.Attributes{"class": "size-full"}),
		Title: "Staff profiles",
		Body:  "Receptionist, clerk, analyst — roles you can shape.",
	},
}

templ WelcomePage(lang, formErr string) {
	@Layout("Welcome — Picomaju") {
		<div class="min-h-dvh flex flex-col items-center">
			<div class="w-full max-w-2xl flex flex-col flex-1 px-6 py-12 gap-12">
				<div class="flex flex-col items-center gap-10 pt-10">
					<img src="/static/logo-symbol.svg" alt="" class="w-38 h-auto"/>
					<div class="text-center">
						<h1>
							Your AI <em class="not-italic text-primary">staff</em>,
						</h1>
						<h2>
							on <em class="not-italic text-primary">your</em> terms.
						</h2>
					</div>
					<div class="text-center">
						<h3>
							Build, configure, orchestrate..
						</h3>
						<p>
							AI agents that run on your device and speak your business.
						</p>
					</div>
					<div class="w-full grid grid-cols-1 sm:grid-cols-3 gap-3">
						for _, f := range welcomeFeatures {
							@card.Card() {
								@card.Content(card.ContentProps{Class: "flex flex-col items-center text-center"}) {
									<div class="text-primary size-9 mb-4" aria-hidden="true">
										@f.Icon
									</div>
									<h4>{ f.Title }</h4>
									<div class="text-muted-foreground">
										{ f.Body }
									</div>
								}
							}
						}
					</div>
				</div>
				<div class="flex flex-col gap-6 pb-safe">
					if formErr != "" {
						@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
							@alert.Description() {
								{ formErr }
							}
						}
					}
					<form method="post" action="/welcome" class="flex flex-col gap-4">
						<div class="flex flex-col gap-1.5">
							@label.Label(label.Props{For: "language"}) {
								Language / Bahasa
							}
							<select id="language" name="language">
								@welcomeLangOption("en", "English", lang == "en" || lang == "")
								@welcomeLangOption("id", "Bahasa Indonesia", lang == "id")
							</select>
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							Get started
						}
					</form>
					<h5 class="text-center">Runs entirely on your device.</h5>
				</div>
			</div>
		</div>
	}
}

templ welcomeLangOption(value, label string, selected bool) {
	if selected {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}
