package shell

import icons "github.com/bryanvaz/go-templ-lucide-icons"
import "picomaju/ui/components/button"

// EmptySidebarNav is a zero-content nav component for pages without sidebar navigation.
templ EmptySidebarNav() {
}

// SettingsTabNav renders the General / Users / Plan tab strip for settings-area pages.
// Pass the active tab key ("general", "users", "plan") and optional right-slot children.
templ SettingsTabNav(active string, nd NavData) {
	<div class="flex items-center justify-between gap-4">
		<nav class="flex items-center gap-1">
			@settingsTab("/settings", "General", active == "general")
			if nd.CurrentUserRole == "owner" {
				@settingsTab("/users", "Users", active == "users")
			}
			@settingsTab("/license", "Plan", active == "plan")
		</nav>
		{ children... }
	</div>
}

templ settingsTab(href, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		class={
			"px-3 py-1.5 rounded-md text-sm font-medium transition-colors",
			templ.KV("bg-muted text-foreground", active),
			templ.KV("text-muted-foreground hover:text-foreground hover:bg-muted", !active),
		}
	>{ label }</a>
}

// SidebarItem renders a single sidebar nav link. Pass the icon as children.
templ SidebarItem(href, lbl, key, active string) {
	<a
		href={ templ.SafeURL(href) }
		class={
			"flex items-center gap-2 mx-2 px-1 py-0.5 rounded-md text-sm transition-colors",
			templ.KV("bg-sidebar-accent text-sidebar-foreground font-medium", active == key),
			templ.KV("text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent", active != key),
		}
	>
		<span class="size-8 shrink-0 flex items-center justify-center">
			{ children... }
		</span>
		<span data-sidebar-label>{ lbl }</span>
	</a>
}

// PageHeader renders a section heading row with an optional right-slot action.
templ PageHeader(title string) {
	<div class="flex items-center justify-between gap-4 pb-4 border-b border-border">
		<h3 class="font-semibold text-foreground">{ title }</h3>
		{ children... }
	</div>
}

// EmptyState renders the zero-items illustration with a primary CTA.
// Pass button.VariantOutline etc. as the optional variant argument.
templ EmptyState(title, desc, href, label string, variant ...button.Variant) {
	{{ v := button.VariantDefault }}
	if len(variant) > 0 {
		{{ v = variant[0] }}
	}
	<div class="flex flex-col items-center justify-center text-center py-16 gap-5">
		<div class="flex flex-col gap-1.5 max-w-xs">
			<h4>{ title }</h4>
			<p class="text-base">{ desc }</p>
		</div>
		@button.Button(button.Props{Href: href, Variant: v}) {
			{ label }
		}
	</div>
}

// ListSection renders a category label above a RowList for grouped "All" views.
templ ListSection(label string) {
	<div class="flex flex-col gap-2">
		<h5 class="text-xs font-mono uppercase tracking-widest text-muted-foreground px-1">{ label }</h5>
		@RowList() {
			{ children... }
		}
	</div>
}

// RowListProps allows optional class override on RowList.
type RowListProps struct {
	Class string
}

// RowList wraps a set of list rows in a bordered card container.
templ RowList(props ...RowListProps) {
	{{ var p RowListProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div class={ "flex flex-col divide-y divide-border rounded-lg border border-border overflow-hidden bg-card", p.Class }>
		{ children... }
	</div>
}

// RowItemProps allows optional class override on RowItem.
type RowItemProps struct {
	Class string
}

// RowItem is a flex row inside a RowList.
templ RowItem(props ...RowItemProps) {
	{{ var p RowItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div class={ "flex items-center gap-3 px-4 py-3", p.Class }>
		{ children... }
	</div>
}

// BadgeVariant controls the color scheme of a Badge.
type BadgeVariant string

const (
	BadgeDefault     BadgeVariant = "default"
	BadgePrimary     BadgeVariant = "primary"
	BadgeDestructive BadgeVariant = "destructive"
	BadgeSuccess     BadgeVariant = "success"
	BadgeOutline     BadgeVariant = "outline"
)

func badgeClasses(v BadgeVariant) string {
	switch v {
	case BadgePrimary:
		return "bg-primary/10 text-primary"
	case BadgeDestructive:
		return "bg-destructive/10 text-destructive"
	case BadgeSuccess:
		return "bg-green-500/10 text-green-700 dark:text-green-400"
	case BadgeOutline:
		return "border border-border text-muted-foreground bg-transparent"
	default:
		return "bg-secondary text-secondary-foreground"
	}
}

// Badge renders a pill tag. Pass an optional BadgeVariant as the second argument.
templ Badge(label string, variant ...BadgeVariant) {
	{{ v := BadgeDefault }}
	if len(variant) > 0 {
		{{ v = variant[0] }}
	}
	<span class={ "inline-flex items-center px-2 py-0.5 rounded-full text-[0.625rem] font-mono uppercase tracking-wide", badgeClasses(v) }>
		{ label }
	</span>
}

// RowActions renders edit + delete icon buttons for a list row.
templ RowActions(editHref, deleteHref, confirmNoun string) {
	<div class="flex items-center gap-0.5 ml-auto shrink-0">
		<a
			href={ templ.SafeURL(editHref) }
			class="inline-flex size-8 items-center justify-center rounded text-muted-foreground hover:text-foreground hover:bg-muted transition-colors"
			aria-label={ "Edit " + confirmNoun }
		>
			@icons.Pencil(templ.Attributes{"class": "size-3.5"})
		</a>
		<form method="post" action={ templ.SafeURL(deleteHref) }>
			<button
				type="submit"
				class="inline-flex size-8 items-center justify-center rounded text-muted-foreground hover:text-destructive hover:bg-destructive/10 transition-colors cursor-pointer"
				aria-label={ "Delete " + confirmNoun }
				data-noun={ confirmNoun }
				onclick="return confirm('Delete this '+this.dataset.noun+'?')"
			>
				@icons.Trash2(templ.Attributes{"class": "size-3.5"})
			</button>
		</form>
	</div>
}

// FormCardProps allows optional class override on FormCard.
type FormCardProps struct {
	Class string
}

// FormCard wraps form content in a surface card.
templ FormCard(props ...FormCardProps) {
	{{ var p FormCardProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div class={ "bg-card rounded-lg border border-border p-5 sm:p-6 flex flex-col gap-5", p.Class }>
		{ children... }
	</div>
}

// FieldProps allows optional class override on Field.
type FieldProps struct {
	Class string
}

// Field wraps a label+input pair with consistent spacing.
templ Field(props ...FieldProps) {
	{{ var p FieldProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div class={ "flex flex-col gap-1.5", p.Class }>
		{ children... }
	</div>
}

// ValueCatIcon renders the icon for a value category by ID.
templ ValueCatIcon(id string) {
	switch id {
		case "core_values":
			@icons.Star(templ.Attributes{"class": "size-4"})
		case "communication":
			@icons.MessageCircle(templ.Attributes{"class": "size-4"})
		case "skills":
			@icons.Zap(templ.Attributes{"class": "size-4"})
		case "escalation":
			@icons.Activity(templ.Attributes{"class": "size-4"})
		default:
			@icons.Settings(templ.Attributes{"class": "size-4"})
	}
}
