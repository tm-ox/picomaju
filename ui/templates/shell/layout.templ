package shell

import icons "github.com/bryanvaz/go-templ-lucide-icons"

// ── Shared sub-components ─────────────────────────────────────────────────────

templ appHead(title string) {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
		<title>{ title } — Picomaju</title>
		<link rel="stylesheet" href="/ui/assets/css/output.css"/>
		<script type="module" src="/static/datastar.js"></script>
		<script>
			(function () {
				var t =
					localStorage.getItem("theme") ||
					(matchMedia("(prefers-color-scheme:dark)").matches ? "dark" : "light");
				if (t === "dark") document.documentElement.classList.add("dark");
			})();
		</script>
	</head>
}

templ appStyles() {
	<style>
		#sidebar { transition: width 200ms ease; }
		#sidebar-main { transition: transform 200ms ease; }
		#sidebar [data-sidebar-label] { white-space: nowrap; }
		dialog { border: none; padding: 0; background: transparent; }
		dialog::backdrop { background: rgba(0,0,0,0.4); }
	</style>
}

templ appSidebarAside(nd NavData, nav templ.Component) {
	<aside
		id="sidebar"
		class="bg-sidebar text-sidebar-foreground flex flex-col shrink-0 overflow-y-auto overflow-x-hidden border-r border-sidebar-border"
	>
		<div class="border-b border-sidebar-border shrink-0 h-12 flex items-center">
			<div class="flex items-center w-full mx-2 px-1">
				<span data-sidebar-label class="size-8 shrink-0 flex items-center justify-center">
					<div class="size-7 rounded-md bg-primary text-primary-foreground font-brand font-bold text-[0.625rem] flex items-center justify-center tracking-wide select-none">
						{ navInitials(nd.BusinessName) }
					</div>
				</span>
				<span data-sidebar-label class="text-sm font-brand font-semibold text-sidebar-foreground/90 truncate flex-1 min-w-0 pl-2">
					if nd.BusinessName != "" {
						{ nd.BusinessName }
					} else {
						PicoMaju
					}
				</span>
				<button
					onclick="toggleSidebar()"
					class="hidden sm:flex size-8 shrink-0 ml-auto items-center justify-center rounded-md text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent transition-colors cursor-pointer"
					aria-label="Toggle sidebar"
				>
					@icons.PanelLeft(templ.Attributes{"class": "size-4"})
				</button>
			</div>
		</div>
		@nav
	</aside>
}

templ appNavLink(href, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		class={
			"flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-ui transition-colors",
			templ.KV("text-foreground bg-muted font-medium", active),
			templ.KV("text-muted-foreground hover:text-foreground hover:bg-muted", !active),
		}
	>
		{ children... }
		{ label }
	</a>
}

templ appTopBar(nd NavData) {
	<header class="shrink-0 h-12 flex items-center border-b border-border px-4">
		<div class="flex-1 flex">
			<button
				class="flex sm:hidden size-8 items-center justify-center rounded-md text-muted-foreground hover:text-foreground hover:bg-muted transition-colors cursor-pointer"
				onclick="toggleSidebar()"
				aria-label="Open sidebar"
			>
				@icons.PanelLeft(templ.Attributes{"class": "size-4"})
			</button>
		</div>
		<nav class="hidden sm:flex items-center gap-0.5" aria-label="Primary">
			@appNavLink("/", "Home", nd.ActiveSection == "home") {
				@icons.House(templ.Attributes{"class": "size-3.5"})
			}
			@appNavLink("/values", "Values", nd.ActiveSection == "values") {
				@icons.Star(templ.Attributes{"class": "size-3.5"})
			}
			@appNavLink("/tools", "Tools", nd.ActiveSection == "tools") {
				@icons.Wrench(templ.Attributes{"class": "size-3.5"})
			}
			@appNavLink("/tasks", "Tasks", nd.ActiveSection == "tasks") {
				@icons.ClipboardList(templ.Attributes{"class": "size-3.5"})
			}
			@appNavLink("/staff", "Staff", nd.ActiveSection == "staff") {
				@icons.UserRound(templ.Attributes{"class": "size-3.5"})
			}
		</nav>
		<div class="flex-1 flex items-center justify-end">
			@userMenuButton(nd)
		</div>
	</header>
}

templ userMenuButton(nd NavData) {
	<div class="relative" data-user-menu>
		<button
			type="button"
			onclick="toggleUserMenu(this)"
			class="size-8 flex items-center justify-center cursor-pointer"
			aria-label="User menu"
		>
			<div class="size-7 rounded-md bg-primary text-primary-foreground font-brand font-bold text-[0.625rem] flex items-center justify-center tracking-wide select-none transition-colors hover:bg-primary/90">
				if nd.CurrentUserName != "" {
					{ userMenuInitials(nd.CurrentUserName) }
				} else {
					@icons.UserRound(templ.Attributes{"class": "size-4"})
				}
			</div>
		</button>
		<div
			data-user-menu-panel
			class="hidden absolute right-0 top-full mt-4 w-72 bg-popover border border-border rounded-xl shadow-lg z-50 py-1 overflow-hidden"
		>
			if nd.CurrentUserName != "" {
				<div class="px-3 py-2.5 border-b border-border">
					<p class="text-xs font-semibold text-foreground truncate">{ nd.CurrentUserName }</p>
					<p class="text-[0.625rem] text-muted-foreground capitalize">{ nd.CurrentUserRole }</p>
				</div>
				@userMenuItem("/profile", "Profile") {
					@icons.UserRound(templ.Attributes{"class": "size-3.5"})
				}
			}
			@userMenuItem("/settings", "Settings") {
				@icons.Settings(templ.Attributes{"class": "size-3.5"})
			}
			<div class="border-t border-border my-1"></div>
			<button
				type="button"
				onclick="var d=document.documentElement,dark=d.classList.toggle('dark');localStorage.setItem('theme',dark?'dark':'light');"
				class="flex items-center gap-2.5 w-full px-3 py-2 text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors cursor-pointer whitespace-nowrap"
			>
				<span class="size-4 flex items-center justify-center shrink-0">
					<svg class="block dark:hidden size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path></svg>
					<svg class="hidden dark:block size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
				</span>
				Toggle theme
			</button>
			if nd.CurrentUserName != "" {
				<div class="border-t border-border my-1"></div>
				<form method="post" action="/logout">
					<button
						type="submit"
						class="flex items-center gap-2.5 w-full px-3 py-2 text-sm text-muted-foreground hover:text-destructive hover:bg-destructive/5 transition-colors cursor-pointer whitespace-nowrap"
					>
						<span class="size-4 flex items-center justify-center shrink-0">
							@icons.LogOut(templ.Attributes{"class": "size-3.5"})
						</span>
						Sign out
					</button>
				</form>
			}
		</div>
	</div>
	<script>
		(function () {
			function toggleUserMenu(btn) {
				var menu = btn.closest('[data-user-menu]');
				var panel = menu.querySelector('[data-user-menu-panel]');
				panel.classList.toggle('hidden');
			}
			window.toggleUserMenu = toggleUserMenu;
			document.addEventListener('click', function (e) {
				document.querySelectorAll('[data-user-menu]').forEach(function (menu) {
					if (!menu.contains(e.target)) {
						menu.querySelector('[data-user-menu-panel]').classList.add('hidden');
					}
				});
			}, true);
		})();
	</script>
}

templ userMenuItem(href, label string) {
	<a
		href={ templ.SafeURL(href) }
		class="flex items-center gap-2.5 px-3 py-2 text-sm text-muted-foreground hover:text-foreground hover:bg-muted transition-colors whitespace-nowrap"
	>
		<span class="size-4 flex items-center justify-center shrink-0">
			{ children... }
		</span>
		{ label }
	</a>
}

func userMenuInitials(name string) string {
	runes := []rune(name)
	if len(runes) == 0 {
		return "?"
	}
	if len(runes) >= 2 {
		return string([]rune{runes[0], runes[1]})
	}
	return string(runes[0:1])
}

templ appSidebarScript() {
	<script>
		(function () {
			var KEY = "sidebar";
			var W = "14rem";
			var ICON_W = "3.5rem";

			function isMobile() {
				return window.innerWidth < 640;
			}

			function apply(open) {
				var sb = document.getElementById("sidebar");
				var main = document.getElementById("sidebar-main");
				var bd = document.getElementById("sidebar-backdrop");
				var labels = sb.querySelectorAll("[data-sidebar-label]");

				if (isMobile()) {
					if (open) {
						sb.style.width = W;
						sb.style.position = "absolute";
						sb.style.zIndex = "50";
						sb.style.height = "100%";
						main.style.transform = "translateX(" + W + ")";
						bd.classList.remove("hidden");
						labels.forEach(function (el) { el.style.display = ""; });
					} else {
						sb.style.width = "0";
						sb.style.position = "";
						sb.style.zIndex = "";
						sb.style.height = "";
						main.style.transform = "";
						bd.classList.add("hidden");
						labels.forEach(function (el) { el.style.display = "none"; });
					}
				} else {
					sb.style.position = "";
					sb.style.zIndex = "";
					sb.style.height = "";
					main.style.transform = "";
					bd.classList.add("hidden");
					sb.style.width = open ? W : ICON_W;
					labels.forEach(function (el) { el.style.display = open ? "" : "none"; });
				}

				localStorage.setItem(KEY, open ? "open" : "closed");
			}

			window.toggleSidebar = function () {
				var saved = localStorage.getItem(KEY);
				var current = saved !== null ? saved === "open" : !isMobile();
				apply(!current);
			};

			var saved = localStorage.getItem(KEY);
			apply(saved !== null ? saved === "open" : !isMobile());

			window.addEventListener("resize", function () {
				var saved = localStorage.getItem(KEY);
				apply(saved !== null ? saved === "open" : !isMobile());
			});
		})();
	</script>
}

templ appContentFooter() {
	<footer class="shrink-0 w-full py-2 text-center leading-none text-[0.625rem] text-muted-foreground/40 select-none">
		<span>Powered by </span><img src="/static/logo-symbol.svg" class="h-[0.625rem] w-auto opacity-40 inline-block align-middle mx-1" alt=""/><span class="font-brand font-semibold"> PicoMaju</span>
	</footer>
}


// ── AppLayout — standard scrollable content shell ─────────────────────────────

templ AppLayout(title string, nd NavData, nav templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		@appHead(title)
		<body class="flex h-dvh overflow-hidden bg-background">
			@appStyles()
			@appSidebarAside(nd, nav)
			<div id="sidebar-backdrop" class="fixed inset-0 z-40 bg-black/30 hidden" onclick="toggleSidebar()"></div>
			<div id="sidebar-main" class="flex-1 min-w-0 flex flex-col overflow-hidden">
				@appTopBar(nd)
				<div class="flex-1 overflow-y-auto">
					<div class="max-w-2xl mx-auto w-full px-6 py-6 flex flex-col gap-6">
						{ children... }
					</div>
				</div>
				@AppBottomTabBar(nd)
				@appContentFooter()
			</div>
			@appSidebarScript()
		</body>
	</html>
}

// ── ChatAppLayout — full-height chat shell with pinned input ──────────────────

templ ChatAppLayout(title string, nd NavData, nav templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		@appHead(title)
		<body class="flex h-dvh overflow-hidden bg-background">
			@appStyles()
			@appSidebarAside(nd, nav)
			<div id="sidebar-backdrop" class="fixed inset-0 z-40 bg-black/30 hidden" onclick="toggleSidebar()"></div>
			<div id="sidebar-main" class="flex-1 min-w-0 flex flex-col overflow-hidden">
				@appTopBar(nd)
				<div class="flex-1 overflow-hidden flex flex-col min-h-0">
					<div class="max-w-2xl mx-auto w-full flex-1 flex flex-col min-h-0 overflow-hidden">
						{ children... }
					</div>
				</div>
				@AppBottomTabBar(nd)
			</div>
			@appSidebarScript()
		</body>
	</html>
}

// ── Layout — unauthenticated shell ────────────────────────────────────────────

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/ui/assets/css/output.css"/>
			<script>
				(function () {
					var t =
						localStorage.getItem("theme") ||
						(matchMedia("(prefers-color-scheme:dark)").matches ? "dark" : "light");
					if (t === "dark") document.documentElement.classList.add("dark");
				})();
			</script>
		</head>
		<body>
			@ThemeToggle()
			{ children... }
		</body>
	</html>
}

templ ThemeToggle() {
	<button
		class="fixed top-4 right-4 z-50 inline-flex size-9 items-center justify-center rounded-md border border-input bg-background text-foreground shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 cursor-pointer"
		aria-label="Toggle theme"
		onclick="var d=document.documentElement,dark=d.classList.toggle('dark');localStorage.setItem('theme',dark?'dark':'light');this.setAttribute('aria-pressed',dark?'true':'false');"
	>
		<svg class="block dark:hidden size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
		</svg>
		<svg class="hidden dark:block size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
		</svg>
	</button>
}
