package shell

import (
	icons "github.com/bryanvaz/go-templ-lucide-icons"
	"strings"
	"unicode"
)

// NavData holds data for the authenticated app shell.
type NavData struct {
	BusinessName            string
	ActiveSection           string // "staff" | "values" | "tools" | "tasks" | "settings" | ""
	CurrentUserName         string
	CurrentUserRole         string
	CurrentUserID           string
	CurrentUserDescription  string
}

// AppBottomTabBar renders the mobile primary navigation as a floating card at the bottom of the content column.
templ AppBottomTabBar(nd NavData) {
	<div class="sm:hidden shrink-0 px-4 pb-4 pt-2">
		<nav class="bg-card rounded-xl border border-border shadow-sm flex items-stretch" aria-label="Primary mobile">
			@bottomTab("/", "Staff", nd.ActiveSection == "staff") {
				@icons.UserRound(templ.Attributes{"class": "size-5"})
			}
			@bottomTab("/values", "Values", nd.ActiveSection == "values") {
				@icons.Star(templ.Attributes{"class": "size-5"})
			}
			@bottomTab("/tools", "Tools", nd.ActiveSection == "tools") {
				@icons.Wrench(templ.Attributes{"class": "size-5"})
			}
			@bottomTab("/tasks", "Tasks", nd.ActiveSection == "tasks") {
				@icons.ClipboardList(templ.Attributes{"class": "size-5"})
			}
		</nav>
	</div>
}

templ bottomTab(href, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		class={
			"flex-1 flex flex-col items-center gap-1 py-2.5 text-[0.6875rem] font-ui transition-colors rounded-xl",
			templ.KV("text-foreground font-medium", active),
			templ.KV("text-muted-foreground", !active),
		}
	>
		{ children... }
		{ label }
	</a>
}

// navInitials returns up to 2 uppercase letters from a business name.
func navInitials(name string) string {
	name = strings.TrimSpace(name)
	if name == "" {
		return "PM"
	}
	fields := strings.Fields(name)
	var out []rune
	for _, f := range fields {
		for _, r := range f {
			if unicode.IsLetter(r) || unicode.IsDigit(r) {
				out = append(out, unicode.ToUpper(r))
				break
			}
		}
		if len(out) >= 2 {
			break
		}
	}
	if len(out) == 0 {
		return "PM"
	}
	return string(out)
}
