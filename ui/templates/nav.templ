package templates

import (
	icons "github.com/bryanvaz/go-templ-lucide-icons"
	"strings"
	"unicode"
)

// NavData holds data for the authenticated app shell.
type NavData struct {
	BusinessName  string
	ActiveSection string // "staff" | "values" | "tools" | "tasks" | "settings" | ""
}

// appNavLink renders a single nav link in the in-content header.
templ appNavLink(href, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		class={
			"px-3 py-1.5 rounded-md text-sm font-ui transition-colors",
			templ.KV("text-foreground bg-muted font-medium", active),
			templ.KV("text-muted-foreground hover:text-foreground hover:bg-muted", !active),
		}
	>
		{ label }
	</a>
}

// AppFAB renders the mobile floating action button for the active section.
templ AppFAB(nd NavData) {
	switch nd.ActiveSection {
		case "staff":
			@appFABLink("/staff/new", "New staff")
		case "values":
			@appFABLink("/values/new", "New value")
		case "tools":
			@appFABLink("/tools/new", "Add tool")
		case "tasks":
			@appFABLink("/tasks/new", "New task")
	}
}

templ appFABLink(href, label string) {
	<a
		href={ templ.SafeURL(href) }
		aria-label={ label }
		class="fixed sm:hidden z-[199] size-[3.25rem] rounded-full bg-primary text-primary-foreground flex items-center justify-center shadow-[0_8px_20px_-6px_rgba(191,9,47,0.5)] transition-transform active:scale-95"
		style="bottom: 1rem; right: 1rem"
	>
		@icons.Plus(templ.Attributes{"class": "size-6"})
	</a>
}

// navInitials returns up to 2 uppercase letters from a business name.
func navInitials(name string) string {
	name = strings.TrimSpace(name)
	if name == "" {
		return "PM"
	}
	fields := strings.Fields(name)
	var out []rune
	for _, f := range fields {
		for _, r := range f {
			if unicode.IsLetter(r) || unicode.IsDigit(r) {
				out = append(out, unicode.ToUpper(r))
				break
			}
		}
		if len(out) >= 2 {
			break
		}
	}
	if len(out) == 0 {
		return "PM"
	}
	return string(out)
}
