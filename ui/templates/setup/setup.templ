package setuptpl

import (
	"picomaju/internal/tool"
	"picomaju/ui/components/alert"
	"picomaju/ui/components/button"
	"picomaju/ui/components/input"
	"picomaju/ui/components/label"
	"picomaju/ui/components/card"
	"picomaju/ui/components/nativeselect"
	"picomaju/ui/templates/shell"
	icons "github.com/bryanvaz/go-templ-lucide-icons"
	"strconv"
)

// ─── Dashboard ────────────────────────────────────────────────────────────────
templ DashboardPage(nd shell.NavData) {
	@shell.AppLayout("Home", nd, shell.EmptySidebarNav()) {
		<div class="flex flex-col items-center justify-center min-h-full py-20 gap-6">
			<img src="/static/logo-symbol.svg" alt="" class="w-44 h-auto"/>
		</div>
	}
}

// ─── Welcome ──────────────────────────────────────────────────────────────────
type welcomeFeature struct {
	Icon  templ.Component
	Title string
	Body  string
}

var welcomeFeatures = []welcomeFeature{
	{
		Icon:  icons.ShieldCheck(templ.Attributes{"class": "size-full"}),
		Title: "Enforced values",
		Body:  "Tone, rules, do's and don'ts — baked in.",
	},
	{
		Icon:  icons.Plug(templ.Attributes{"class": "size-full"}),
		Title: "Your tools",
		Body:  "WhatsApp, Shopee, Xendit, Calendar & more.",
	},
	{
		Icon:  icons.Users(templ.Attributes{"class": "size-full"}),
		Title: "Staff profiles",
		Body:  "Receptionist, clerk, analyst — roles you can shape.",
	},
}

templ WelcomePage(lang, formErr string) {
	@shell.Layout("Welcome — Picomaju") {
		<div class="min-h-dvh flex flex-col items-center">
			<div class="w-full max-w-2xl flex flex-col flex-1 px-6 py-12 gap-12">
				<div class="flex flex-col items-center gap-10 pt-10">
					<img src="/static/logo-symbol.svg" alt="" class="w-38 h-auto"/>
					<div class="text-center">
						<h1>
							Your AI <em class="not-italic text-primary">staff</em>,
						</h1>
						<h2>
							on <em class="not-italic text-primary">your</em> terms.
						</h2>
					</div>
					<div class="text-center">
						<h3>
							Build, configure, orchestrate..
						</h3>
						<p>
							AI agents that run on your device and speak your business.
						</p>
					</div>
					<div class="w-full grid grid-cols-1 sm:grid-cols-3 gap-3">
						for _, f := range welcomeFeatures {
							@card.Card() {
								@card.Content(card.ContentProps{Class: "flex flex-col items-center text-center"}) {
									<div class="text-primary size-9 mb-4" aria-hidden="true">
										@f.Icon
									</div>
									<h4>{ f.Title }</h4>
									<div class="text-muted-foreground">
										{ f.Body }
									</div>
								}
							}
						}
					</div>
				</div>
				<div class="flex flex-col gap-6 pb-safe">
					if formErr != "" {
						@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
							@alert.Description() {
								{ formErr }
							}
						}
					}
					<form method="post" action="/welcome" class="flex flex-col gap-4">
						<div class="flex flex-col gap-1.5">
							@label.Label(label.Props{For: "language"}) {
								Language / Bahasa
							}
							@nativeselect.Select(nativeselect.Props{ID: "language", Name: "language"}) {
								@welcomeLangOption("en", "English", lang == "en" || lang == "")
								@welcomeLangOption("id", "Bahasa Indonesia", lang == "id")
							}
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							Get started
						}
					</form>
					<h5 class="text-center">Runs entirely on your device.</h5>
				</div>
			</div>
		</div>
	}
}

templ welcomeLangOption(value, label string, selected bool) {
	if selected {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

// ─── Setup steps ─────────────────────────────────────────────────────────────
templ setupProgress(step, total int) {
	<div class="flex flex-col gap-2">
		<h5>Step { strconv.Itoa(step) } of { strconv.Itoa(total) }</h5>
		<div class="flex gap-1.5">
			for i := 1; i <= total; i++ {
				if i <= step {
					<div class="h-1 flex-1 rounded-full bg-primary"></div>
				} else {
					<div class="h-1 flex-1 rounded-full bg-border"></div>
				}
			}
		</div>
	</div>
}

templ SetupStep1Page(businessName, dataDir, timezone, hours, formErr string) {
	@shell.Layout("Setup — Picomaju") {
		<div class="min-h-dvh flex flex-col items-center">
			<div class="w-full max-w-2xl flex flex-col px-6 py-12 gap-8">
				@setupProgress(1, 3)
				<div>
					<h3 class="font-semibold">About your business</h3>
					<p>Tell us about your business and where its data should live. You can change this later.</p>
				</div>
				if formErr != "" {
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
						@alert.Description() {
							{ formErr }
						}
					}
				}
				<form method="post" action="/setup" class="flex flex-col gap-5">
					<div class="flex flex-col gap-1.5">
						@label.Label(label.Props{For: "business_name"}) {
							Business name
						}
						@input.Input(input.Props{ID: "business_name", Name: "business_name", Value: businessName, Placeholder: "Acme Co.", Required: true})
					</div>
					<div class="flex flex-col gap-1.5">
						@label.Label(label.Props{For: "data_dir"}) {
							Data directory
						}
						@input.Input(input.Props{ID: "data_dir", Name: "data_dir", Value: dataDir, Required: true})
						<div class="text-sm text-muted-foreground">Picomaju will create this folder if it does not exist.</div>
					</div>
					<div class="flex flex-col gap-1.5">
						@label.Label(label.Props{For: "timezone"}) {
							Timezone
						}
						@nativeselect.Select(nativeselect.Props{ID: "timezone", Name: "timezone"}) {
							@tzOption("Asia/Jakarta", timezone)
							@tzOption("Asia/Makassar", timezone)
							@tzOption("Asia/Jayapura", timezone)
							@tzOption("Asia/Singapore", timezone)
							@tzOption("Asia/Bangkok", timezone)
							@tzOption("Asia/Hong_Kong", timezone)
							@tzOption("Asia/Tokyo", timezone)
							@tzOption("Australia/Sydney", timezone)
							@tzOption("Europe/London", timezone)
							@tzOption("America/New_York", timezone)
							@tzOption("UTC", timezone)
						}
					</div>
					<div class="flex flex-col gap-1.5">
						@label.Label(label.Props{For: "hours"}) {
							Operating hours
						}
						@input.Input(input.Props{ID: "hours", Name: "hours", Value: hours, Placeholder: "Mon–Fri, 09:00–18:00"})
						<div class="text-sm text-muted-foreground">Free text — e.g. "24/7" or "Mon–Sat, 08:00–20:00".</div>
					</div>
					@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
						Continue
					}
				</form>
			</div>
		</div>
	}
}

templ tzOption(tz, selected string) {
	if tz == selected {
		<option value={ tz } selected>{ tz }</option>
	} else {
		<option value={ tz }>{ tz }</option>
	}
}

templ SetupStep2Page(staffName, staffRole, formErr string) {
	@shell.Layout("Setup — Picomaju") {
		<div class="min-h-dvh flex flex-col items-center">
			<div class="w-full max-w-2xl flex flex-col px-6 py-12 gap-8">
				@setupProgress(2, 3)
				<div>
					<h3 class="font-semibold">Your first staff profile</h3>
					<p>A staff profile is an agent that represents a role — like a receptionist or billing clerk. You can edit or add more later.</p>
				</div>
				if formErr != "" {
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
						@alert.Description() {
							{ formErr }
						}
					}
				}
				<form method="post" action="/setup/first-staff" class="flex flex-col gap-5">
					<div class="flex flex-col gap-1.5">
						@label.Label(label.Props{For: "label"}) {
							Profile name
						}
						@input.Input(input.Props{ID: "label", Name: "label", Value: staffName, Placeholder: "Reception Desk", Required: true})
					</div>
					<div class="flex flex-col gap-1.5">
						@label.Label(label.Props{For: "role"}) {
							Short description
						}
						@input.Input(input.Props{ID: "role", Name: "role", Value: staffRole, Placeholder: "Greets customers, answers basic questions"})
						<h5>Optional</h5>
					</div>
					<div class="flex flex-col gap-2 pt-2">
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							Continue
						}
						<a href="/setup/integrations" class="flex h-9 w-full items-center justify-center rounded-md text-sm text-muted-foreground hover:text-foreground transition-colors">
							<h5>Skip for now</h5>
						</a>
					</div>
				</form>
			</div>
		</div>
	}
}

templ SetupStep3Page(groups []tool.IntegrationGroup, formErr string) {
	@shell.Layout("Setup — Picomaju") {
		<div class="min-h-dvh flex flex-col items-center">
			<div class="w-full max-w-2xl flex flex-col px-6 py-12 gap-8">
				@setupProgress(3, 3)
				<div>
					<h3 class="font-semibold">Connect your tools</h3>
					<p>Select the integrations your business uses. You can configure credentials later under Tools.</p>
				</div>
				if formErr != "" {
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
						@alert.Description() {
							{ formErr }
						}
					}
				}
				<form method="post" action="/setup/integrations" class="flex flex-col gap-6">
					for _, group := range groups {
						<div class="flex flex-col gap-1">
							<h5>{ group.Category }</h5>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
								for _, integ := range group.Integrations {
									<label class="flex items-start gap-3 p-4 rounded-lg border border-border cursor-pointer transition-colors bg-card hover:bg-muted has-[:checked]:border-primary has-[:checked]:bg-primary/5">
										<input type="checkbox" name="integrations" value={ integ.ID } class="hidden"/>
										<div class="flex flex-col gap-0.5 min-w-0">
											<h4>{ integ.Label }</h4>
											<div class="text-sm text-muted-foreground">{ integ.Description }</div>
										</div>
									</label>
								}
							</div>
						</div>
					}
					<div class="flex flex-col gap-2">
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							Finish setup
						}
						<a href="/values" class="flex h-9 w-full items-center justify-center rounded-md text-sm text-muted-foreground hover:text-foreground transition-colors">
							<h5>Skip for now</h5>
						</a>
					</div>
				</form>
			</div>
		</div>
	}
}
