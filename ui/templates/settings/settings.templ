package settingstpl

import (
	internalsettings "picomaju/internal/settings"
	"picomaju/ui/components/alert"
	"picomaju/ui/components/button"
	"picomaju/ui/components/input"
	"picomaju/ui/components/label"
	"picomaju/ui/components/textarea"
	"picomaju/ui/templates/shell"
)

templ SettingsPage(cfg *internalsettings.Settings, activeDataDir string, nd shell.NavData, saved bool, formErr string) {
	@shell.AppLayout("Settings", nd, shell.EmptySidebarNav()) {
		@shell.PageHeader("Settings")
		if saved {
			@alert.Alert() {
				@alert.Description() {
					Settings saved.
				}
			}
		}
		if formErr != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				@alert.Description() {
					{ formErr }
				}
			}
		}
		<form method="post" action="/settings" class="bg-card rounded-lg border border-border p-5 sm:p-6 flex flex-col gap-5">
			@shell.Field() {
				@label.Label(label.Props{For: "business_name"}) {
					Business name
				}
				@input.Input(input.Props{ID: "business_name", Name: "business_name", Value: cfg.BusinessName, Placeholder: "Acme Co."})
			}
			@shell.Field() {
				@label.Label(label.Props{For: "business_details"}) {
					Business details
				}
				@textarea.Textarea(textarea.Props{ID: "business_details", Name: "business_details", Rows: 4, Placeholder: "Describe your business, tone, key values…", Value: cfg.BusinessDetails})
				<p class="text-sm text-muted-foreground">Used to personalise agent context across all staff profiles.</p>
			}
			@shell.Field() {
				@label.Label(label.Props{For: "data_dir"}) {
					Data directory
				}
				@input.Input(input.Props{ID: "data_dir", Name: "data_dir", Value: cfg.DataDir, Placeholder: activeDataDir})
				<p class="text-sm text-muted-foreground">
					Active: <code class="font-mono text-xs bg-muted px-1 py-0.5 rounded">{ activeDataDir }</code>. Existing data will not be moved if you change this.
				</p>
			}
			@button.Button(button.Props{Type: button.TypeSubmit}) {
				Save
			}
		</form>
	}
}
