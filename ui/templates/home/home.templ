package hometpl

import (
	"fmt"
	"time"

	icons "github.com/bryanvaz/go-templ-lucide-icons"
	"picomaju/internal/event"
	"picomaju/ui/templates/shell"
)

// HomeData is all pre-computed data the home page needs.
type HomeData struct {
	AgentCount    int
	ActiveCount   int
	MessagesToday int
	Credits       string
	RecentChats   []RecentChat
	RecentEvents  []event.Event
	Agents        []AgentStatus
}

type RecentChat struct {
	ID         string
	StaffID    string
	StaffLabel string
	Title      string
	LastMsg    string
	CreatedAt  int64
}

type AgentStatus struct {
	ID      string
	Label   string
	Active  bool
	Running bool
}

templ HomePage(nd shell.NavData, tab string, d HomeData) {
	@shell.AppLayout("Home", nd, shell.EmptySidebarNav()) {
		<div class="flex flex-col gap-1">
			<h3 class="font-brand font-bold text-foreground">{ greeting(nd.CurrentUserName) }</h3>
			if nd.CurrentUserDescription != "" {
				<p class="text-sm text-muted-foreground">{ nd.CurrentUserDescription }</p>
			}
		</div>
		<nav class="flex items-center gap-1">
			@homeTab("?t=overview", "Overview", tab == "overview" || tab == "")
			@homeTab("?t=activity", "Activity", tab == "activity")
			@homeTab("?t=agents", "Agents", tab == "agents")
		</nav>
		switch tab {
		case "activity":
			@activityTab(d)
		case "agents":
			@agentsTab(d)
		default:
			@overviewTab(d)
		}
	}
}

templ homeTab(href, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		class={
			"px-3 py-1.5 rounded-md text-sm font-medium transition-colors",
			templ.KV("bg-muted text-foreground", active),
			templ.KV("text-muted-foreground hover:text-foreground hover:bg-muted", !active),
		}
	>{ label }</a>
}

templ overviewTab(d HomeData) {
	<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
		@homeStat("Agents", fmt.Sprintf("%d", d.AgentCount)) {
			@icons.Bot(templ.Attributes{"class": "size-4 text-muted-foreground"})
		}
		@homeStat("Active now", fmt.Sprintf("%d", d.ActiveCount)) {
			@icons.Activity(templ.Attributes{"class": "size-4 text-muted-foreground"})
		}
		@homeStat("Messages today", fmt.Sprintf("%d", d.MessagesToday)) {
			@icons.MessageSquare(templ.Attributes{"class": "size-4 text-muted-foreground"})
		}
		@homeStat("Credits", d.Credits) {
			@icons.Zap(templ.Attributes{"class": "size-4 text-muted-foreground"})
		}
	</div>
	if len(d.RecentEvents) == 0 {
		@homePlaceholderCard("Recent activity", "Agent actions and reports will appear here once agents are running.")
	} else {
		<div class="bg-card rounded-lg border border-border divide-y divide-border">
			<div class="px-5 py-3">
				<h5 class="text-sm font-brand font-semibold text-foreground">Recent activity</h5>
			</div>
			for _, e := range d.RecentEvents {
				if e.Type != event.EventTypeApprovalResult {
					@eventRow(e)
				}
			}
		</div>
	}
}

templ activityTab(d HomeData) {
	if len(d.RecentEvents) == 0 {
		@homePlaceholderCard("Activity log", "Agent actions, messages, and approval requests will appear here once agents are running.")
	} else {
		<div class="bg-card rounded-lg border border-border divide-y divide-border">
			<div class="px-5 py-3">
				<h5 class="text-sm font-brand font-semibold text-foreground">All activity</h5>
			</div>
			for _, e := range d.RecentEvents {
				@eventRow(e)
			}
		</div>
	}
}

templ eventRow(e event.Event) {
	<a href={ templ.SafeURL("/staff/" + e.AgentID) } class="flex items-start gap-3 px-5 py-3 hover:bg-muted/50 transition-colors">
		<span class={ "mt-0.5 size-2 rounded-full shrink-0", eventDotClass(e.Type) }></span>
		<div class="flex-1 min-w-0">
			<div class="flex items-center justify-between gap-2">
				<span class="text-sm text-foreground truncate">{ e.Summary }</span>
				<span class="text-xs text-muted-foreground shrink-0">{ relativeTime(e.Timestamp) }</span>
			</div>
			if e.Channel != "" {
				<span class="text-xs text-muted-foreground">{ e.Channel }</span>
			}
		</div>
	</a>
}

func eventDotClass(t event.EventType) string {
	switch t {
	case event.EventTypeApprovalRequest:
		return "bg-yellow-500"
	case event.EventTypeError:
		return "bg-red-500"
	case event.EventTypeMessage:
		return "bg-blue-500"
	default:
		return "bg-green-500"
	}
}

templ agentsTab(d HomeData) {
	if len(d.Agents) == 0 {
		@homePlaceholderCard("No agents", "Create a staff profile to get started.")
	} else {
		<div class="bg-card rounded-lg border border-border divide-y divide-border">
			<div class="px-5 py-3">
				<h5 class="text-sm font-brand font-semibold text-foreground">Agent status</h5>
			</div>
			for _, a := range d.Agents {
				<a href={ templ.SafeURL("/staff/" + a.ID) } class="flex items-center gap-3 px-5 py-3 hover:bg-muted/50 transition-colors">
					<span
						class={
							"size-2 rounded-full shrink-0",
							templ.KV("bg-green-500", a.Running),
							templ.KV("bg-muted-foreground/30", !a.Running),
						}
					></span>
					<span class="text-sm font-medium text-foreground flex-1">{ a.Label }</span>
					<span class="text-xs text-muted-foreground">
						if a.Running {
							Running
						} else if a.Active {
							Inactive
						} else {
							Draft
						}
					</span>
				</a>
			}
		</div>
	}
}

templ homeStat(label, value string) {
	<div class="bg-card rounded-lg border border-border p-4 flex flex-col gap-2">
		<div class="flex items-center justify-between">
			<span class="text-xs font-mono text-muted-foreground uppercase tracking-wide">{ label }</span>
			{ children... }
		</div>
		<span class="text-sm font-brand font-semibold text-foreground">{ value }</span>
	</div>
}

templ homePlaceholderCard(title, desc string) {
	<div class="bg-card rounded-lg border border-border p-5 flex flex-col gap-2">
		<h5 class="text-sm font-brand font-semibold text-foreground">{ title }</h5>
		<p class="text-sm text-muted-foreground">{ desc }</p>
	</div>
}

func greeting(name string) string {
	if name == "" {
		return "Welcome back"
	}
	return "Welcome back, " + name
}

func relativeTime(unix int64) string {
	d := time.Since(time.Unix(unix, 0))
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		return fmt.Sprintf("%dm ago", int(d.Minutes()))
	case d < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(d.Hours()))
	default:
		return time.Unix(unix, 0).Format("Jan 2")
	}
}
