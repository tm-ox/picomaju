package nativeselect

import (
	"picomaju/ui/components/icon"
	"picomaju/ui/utils"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Name       string
	Disabled   bool
	Required   bool
	HasError   bool
}

templ Select(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div class="relative w-full">
		<select
			if p.ID != "" {
				id={ p.ID }
			}
			if p.Name != "" {
				name={ p.Name }
			}
			disabled?={ p.Disabled }
			required?={ p.Required }
			if p.HasError {
				aria-invalid="true"
			}
			class={
				utils.TwMerge(
					"flex h-9 w-full min-w-0 appearance-none rounded-md border border-input bg-card text-foreground px-3 py-1 pr-8 text-base shadow-xs transition-[color,box-shadow] outline-none md:text-sm",
					"focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]",
					"disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50",
					"aria-invalid:ring-destructive/20 aria-invalid:border-destructive dark:aria-invalid:ring-destructive/40",
					utils.If(p.HasError, "border-destructive ring-destructive/20 dark:ring-destructive/40"),
					p.Class,
				),
			}
			{ p.Attributes... }
		>
			{ children... }
		</select>
		<span class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground">
			@icon.ChevronDown(icon.Props{Class: "size-4"})
		</span>
	</div>
}
