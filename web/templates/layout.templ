package templates

templ Layout(title string, sb SidebarData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — Picomaju</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script type="module" src="/static/datastar.js"></script>
			<!-- Apply saved theme before first paint -->
			<script>
				(function(){
					var t = localStorage.getItem('theme') ||
						(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
					document.documentElement.setAttribute('data-theme', t);
				})();
			</script>
		</head>
		<body>
			<header class="topnav">
				<div class="topnav-left">
					<div class="topnav-avatar"></div>
					<span class="topnav-business">
						if sb.BusinessName != "" {
							{ sb.BusinessName }
						} else {
							Picomaju
						}
					</span>
				</div>
				<nav class="topnav-center">
					<a href="/values" class={ "topnav-link", templ.KV("active", sb.ActiveSection == "values") }>Values</a>
					<a href="/tools" class={ "topnav-link", templ.KV("active", sb.ActiveSection == "tools") }>Tools</a>
					<a href="/roles" class={ "topnav-link", templ.KV("active", sb.ActiveSection == "roles") }>Roles</a>
					<a href="/staff" class={ "topnav-link", templ.KV("active", sb.ActiveSection == "staff") }>Staff</a>
				</nav>
				<div class="topnav-right">
					<button
						class="theme-toggle"
						title="Toggle theme"
						onclick="
							var t = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
							document.documentElement.setAttribute('data-theme', t);
							localStorage.setItem('theme', t);
						"
					></button>
					<a href="/settings" class="topnav-settings" title="Settings">&#9881;</a>
				</div>
			</header>
			<div class="app-body">
				@sidebar(sb)
				<main class="main">
					{ children... }
				</main>
			</div>
			<footer class="app-footer">
				<span>Powered by PicoMaju</span>
			</footer>
			<!-- Restore sidebar collapsed state after render -->
			<script>
				(function(){
					if (localStorage.getItem('sidebar-collapsed') === '1') {
						var s = document.getElementById('sidebar');
						if (s) s.classList.add('collapsed');
					}
				})();
			</script>
		</body>
	</html>
}
