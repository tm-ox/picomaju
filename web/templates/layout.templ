package templates

import "strings"
import "unicode"

templ Layout(title string, sb SidebarData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<title>{ title } — Picomaju</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script type="module" src="/static/datastar.js"></script>
			<!-- Apply saved theme before first paint -->
			<script>
				(function(){
					var t = localStorage.getItem('theme') ||
						(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
					document.documentElement.setAttribute('data-theme', t);
				})();
			</script>
		</head>
		<body>
			if sb.HideSidebar {
				<header class="topnav topnav-minimal">
					<div class="topnav-left">
						<img src="/static/logo-type.svg" class="topnav-logo" alt="PicoMaju"/>
					</div>
				</header>
				<div class="app-body app-body-full">
					<main class="main">
						{ children... }
					</main>
				</div>
			} else {
				<header class="topnav">
					<div class="topnav-left">
						<div class="topnav-avatar">{ initials(sb.BusinessName) }</div>
						<span class="topnav-business">
							if sb.BusinessName != "" {
								{ sb.BusinessName }
							} else {
								Picomaju
							}
						</span>
					</div>
					<nav class="topnav-center">
						<a href="/" class={ "topnav-link", templ.KV("active", sb.ActiveSection == "home") }>Home</a>
						<a href="/values" class={ "topnav-link", templ.KV("active", sb.ActiveSection == "values") }>Values</a>
						<a href="/tools" class={ "topnav-link", templ.KV("active", sb.ActiveSection == "tools") }>Tools</a>
						<a href="/tasks" class={ "topnav-link", templ.KV("active", sb.ActiveSection == "tasks") }>Tasks</a>
						<a href="/staff" class={ "topnav-link", templ.KV("active", sb.ActiveSection == "staff") }>Staff</a>
					</nav>
					<div class="topnav-right">
						<button
							class="theme-toggle"
							title="Toggle theme"
							onclick="
								var t = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
								document.documentElement.setAttribute('data-theme', t);
								localStorage.setItem('theme', t);
							"
						>@iconMoon()
@iconSun()
</button>
						<a href="/settings" class="topnav-settings" title="Settings">&#9881;</a>
					</div>
				</header>
				<div class="app-body">
					@sidebar(sb)
					<main class="main">
						{ children... }
					</main>
				</div>
				<footer class="app-footer">
					<img src="/static/logo-type.svg" class="footer-logo" alt="PicoMaju"/>
				</footer>
				@bottomTabs(sb)
				@fab(sb)
				<!-- Restore sidebar collapsed state after render -->
				<script>
					(function(){
						if (localStorage.getItem('sidebar-collapsed') === '1') {
							var s = document.getElementById('sidebar');
							if (s) s.classList.add('collapsed');
						}
					})();
				</script>
			}
		</body>
	</html>
}

// bottomTabs renders the mobile bottom tab bar.
templ bottomTabs(sb SidebarData) {
	<nav class="tabbar" aria-label="Primary">
		<div class="tabbar-inner">
			<a href="/" class={ "tab", templ.KV("active", sb.ActiveSection == "home") }>
				@tabIconHome()
				<span>Home</span>
			</a>
			<a href="/values" class={ "tab", templ.KV("active", sb.ActiveSection == "values") }>
				@tabIconValues()
				<span>Values</span>
			</a>
			<a href="/tools" class={ "tab", templ.KV("active", sb.ActiveSection == "tools") }>
				@tabIconTools()
				<span>Tools</span>
			</a>
			<a href="/tasks" class={ "tab", templ.KV("active", sb.ActiveSection == "tasks") }>
				@tabIconTasks()
				<span>Tasks</span>
			</a>
			<a href="/staff" class={ "tab", templ.KV("active", sb.ActiveSection == "staff") }>
				@tabIconStaff()
				<span>Staff</span>
			</a>
		</div>
	</nav>
}

// fab renders a mobile floating action button for the active section.
templ fab(sb SidebarData) {
	switch sb.ActiveSection {
		case "values":
			<a class="fab" href="/values/new" aria-label="New value">@fabPlus()
</a>
		case "tools":
			<a class="fab" href="/tools/new" aria-label="Add tool">@fabPlus()
</a>
		case "tasks":
			<a class="fab" href="/tasks/new" aria-label="New task">@fabPlus()
</a>
		case "staff":
			<a class="fab" href="/staff/new" aria-label="New staff">@fabPlus()
</a>
	}
}

// --- Tab bar icon glyphs ---
templ tabIconValues() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 3l2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 16.3 6.8 19l1-5.8-4.2-4.1 5.8-.8L12 3z"></path>
	</svg>
}

templ tabIconTools() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M14.7 6.3a4 4 0 105.7 5.7l-2.8-2.8 1.4-1.4 2.8 2.8a6 6 0 11-8.5-8.5l2.8 2.8-1.4 1.4z"></path>
		<path d="M3 21l7.5-7.5"></path>
	</svg>
}

templ tabIconTasks() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect x="4" y="4" width="16" height="16" rx="3"></rect>
		<path d="M8 12l3 3 5-6"></path>
	</svg>
}

templ tabIconStaff() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="8" r="3.5"></circle>
		<path d="M4.5 20c.8-3.8 4-6 7.5-6s6.7 2.2 7.5 6"></path>
	</svg>
}

templ fabPlus() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
		<path d="M12 5v14M5 12h14"></path>
	</svg>
}

// initials returns up to 2 uppercase letters derived from a business name.
// Empty or non-letter input falls back to "PM".
func initials(name string) string {
	name = strings.TrimSpace(name)
	if name == "" {
		return "PM"
	}
	fields := strings.Fields(name)
	var out []rune
	for _, f := range fields {
		for _, r := range f {
			if unicode.IsLetter(r) || unicode.IsDigit(r) {
				out = append(out, unicode.ToUpper(r))
				break
			}
		}
		if len(out) >= 2 {
			break
		}
	}
	if len(out) == 0 {
		return "PM"
	}
	return string(out)
}
