package templates

templ Layout(title string, sb SidebarData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — Picomaju</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script type="module" src="/static/datastar.js"></script>
			<!-- Apply saved theme before first paint -->
			<script>
				(function(){
					var t = localStorage.getItem('theme') ||
						(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
					document.documentElement.setAttribute('data-theme', t);
				})();
			</script>
		</head>
		<body>
			if sb.HideSidebar {
				<header class="topnav topnav-minimal">
					<div class="topnav-left">
						<img src="/static/logo-type.svg" class="topnav-logo" alt="PicoMaju"/>
					</div>
				</header>
				<div class="app-body app-body-full">
					<main class="main">
						{ children... }
					</main>
				</div>
			} else {
				<header class="topnav">
					<div class="topnav-left">
						<div class="topnav-avatar"></div>
						<span class="topnav-business">
							if sb.BusinessName != "" {
								{ sb.BusinessName }
							} else {
								Picomaju
							}
						</span>
					</div>
					<nav class="topnav-center">
						<a href="/values" class={ "topnav-link", templ.KV("active", sb.ActiveSection == "values") }>Values</a>
						<a href="/tools" class={ "topnav-link", templ.KV("active", sb.ActiveSection == "tools") }>Tools</a>
						<a href="/tasks" class={ "topnav-link", templ.KV("active", sb.ActiveSection == "tasks") }>Tasks</a>
						<a href="/staff" class={ "topnav-link", templ.KV("active", sb.ActiveSection == "staff") }>Staff</a>
					</nav>
					<div class="topnav-right">
						<button
							class="theme-toggle"
							title="Toggle theme"
							onclick="
								var t = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
								document.documentElement.setAttribute('data-theme', t);
								localStorage.setItem('theme', t);
							"
						></button>
						<a href="/settings" class="topnav-settings" title="Settings">&#9881;</a>
					</div>
				</header>
				<div class="app-body">
					@sidebar(sb)
					<main class="main">
						{ children... }
					</main>
				</div>
				<footer class="app-footer">
					<svg class="footer-logo" xmlns="http://www.w3.org/2000/svg" viewBox="83 2 229 46" fill="none" aria-label="PicoMaju">
						<path fill="currentColor" d="M83,38.791L89.806,38.791L89.806,24.802L96.629,24.802C101.845,24.802,104.23,24.403,106.267,23.159C109.248,21.267,111.085,17.583,111.085,13.351C111.085,9.119,109.297,5.634,106.117,3.693C104.031,2.448,101.547,2,96.728,2L83,2ZM89.806,18.28L89.806,8.522L96.728,8.522C98.964,8.522,100.008,8.621,101.05,8.87C103.037,9.418,104.23,11.161,104.23,13.451C104.23,15.243,103.435,16.637,101.995,17.434C100.951,17.981,99.113,18.28,96.431,18.28ZM115.811,38.791L122.419,38.791L122.419,11.21L115.811,11.21ZM115.811,8.223L122.419,8.223L122.419,2L115.811,2ZM148.38,29.73C146.74,32.269,144.853,33.365,142.12,33.365C137.55,33.365,134.122,29.78,134.122,24.951C134.122,20.072,137.351,16.637,141.971,16.637C144.952,16.637,147.039,17.881,148.38,20.421L155.832,20.421C154.888,17.632,153.993,16.189,152.105,14.446C149.423,11.957,145.796,10.563,141.971,10.563C133.824,10.563,127.465,16.886,127.465,25.001C127.465,33.016,134.023,39.438,142.169,39.438C148.628,39.438,153.546,35.904,155.832,29.73ZM174.026,10.563C166.027,10.563,159.47,17.085,159.47,25.001C159.47,32.966,166.027,39.438,174.076,39.438C182.074,39.438,188.73,32.966,188.73,25.2C188.73,16.985,182.322,10.563,174.026,10.563ZM174.076,16.637C178.497,16.637,182.074,20.371,182.074,25.001C182.074,29.631,178.497,33.365,174.125,33.365C169.654,33.365,166.127,29.631,166.127,24.901C166.127,20.371,169.704,16.637,174.076,16.637ZM194.145,38.791L200.951,38.791L200.951,11.21L210.539,38.791L216.103,38.791L225.691,11.21L225.691,38.791L232.497,38.791L232.497,2L223.157,2L213.371,29.88L203.485,2L194.145,2ZM266.533,11.21L260.472,11.21L260.472,14.894C258.187,11.858,255.455,10.563,251.48,10.563C243.333,10.563,237.471,16.687,237.471,25.1C237.471,33.414,243.283,39.438,251.331,39.438C255.206,39.438,257.839,38.243,260.472,35.207L260.472,38.791L266.533,38.791ZM252.176,16.637C256.896,16.637,260.273,20.172,260.273,25.2C260.273,27.191,259.479,29.481,258.286,30.875C256.945,32.518,254.809,33.365,252.275,33.365C247.457,33.365,244.128,30.079,244.128,25.25C244.128,20.221,247.457,16.637,252.176,16.637ZM274.091,11.21L274.091,36.8C274.14,40.534,273.792,41.181,271.358,41.579L271.358,48.001C277.419,47.902,280.897,43.819,280.698,36.949L280.698,11.21ZM274.091,8.223L280.698,8.223L280.698,2L274.091,2ZM312.001,11.21L305.395,11.21L305.395,24.204C305.395,27.888,305.146,29.631,304.351,30.826C303.407,32.469,301.569,33.365,299.334,33.365C297.644,33.365,296.353,32.817,295.459,31.622C294.515,30.427,294.117,28.436,294.117,24.702L294.117,11.21L287.51,11.21L287.51,25.996C287.51,30.676,288.057,33.116,289.597,35.356C291.435,37.995,294.366,39.438,297.993,39.438C301.321,39.438,303.358,38.592,305.892,36.153L305.892,38.791L312.001,38.791Z"></path>
					</svg>
				</footer>
				<!-- Restore sidebar collapsed state after render -->
				<script>
					(function(){
						if (localStorage.getItem('sidebar-collapsed') === '1') {
							var s = document.getElementById('sidebar');
							if (s) s.classList.add('collapsed');
						}
					})();
				</script>
			}
		</body>
	</html>
}
