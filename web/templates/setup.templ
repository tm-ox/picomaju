package templates

import "picomaju/internal/tool"

// ─── Welcome screen (pre-onboarding) ────────────────────────────────────────
templ WelcomePage(lang, formErr string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<title>Welcome — PicoMaju</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/app.js"></script>
		</head>
		<body class="welcome-body">
			<div class="welcome-screen">
				<div class="welcome-top">
					<div class="welcome-symbol-wrap">
						<img src="/static/logo-symbol.svg" class="welcome-symbol" alt=""/>
					</div>
					<div class="welcome-copy">
						<h1 class="welcome-tagline">Your AI <em>staff</em>, on your terms.</h1>
						<p class="welcome-desc">Build, configure, and orchestrate AI agents that run on your device and speak your business.</p>
						<ul class="welcome-features">
							<li class="welcome-feature">
								<span class="welcome-feature-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="8" r="3.5"></circle>
										<path d="M4.5 20c.8-3.8 4-6 7.5-6s6.7 2.2 7.5 6"></path>
									</svg>
								</span>
								<div class="welcome-feature-text">
									<span class="welcome-feature-title">Staff profiles</span>
									<span class="welcome-feature-desc">Receptionist, clerk, analyst — roles you can shape.</span>
								</div>
							</li>
							<li class="welcome-feature">
								<span class="welcome-feature-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M14.7 6.3a4 4 0 105.7 5.7l-2.8-2.8 1.4-1.4 2.8 2.8a6 6 0 11-8.5-8.5l2.8 2.8-1.4 1.4z"></path>
										<path d="M3 21l7.5-7.5"></path>
									</svg>
								</span>
								<div class="welcome-feature-text">
									<span class="welcome-feature-title">Connect your tools</span>
									<span class="welcome-feature-desc">WhatsApp, Shopee, Xendit, Calendar &amp; more.</span>
								</div>
							</li>
							<li class="welcome-feature">
								<span class="welcome-feature-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 3l2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 16.3 6.8 19l1-5.8L3.6 9.1l5.8-.8L12 3z"></path>
									</svg>
								</span>
								<div class="welcome-feature-text">
									<span class="welcome-feature-title">Your values, enforced</span>
									<span class="welcome-feature-desc">Tone, rules, do's and don'ts — baked in.</span>
								</div>
							</li>
						</ul>
					</div>
				</div>
				<div class="welcome-bottom">
					if formErr != "" {
						<div class="alert alert-error">{ formErr }</div>
					}
					<form method="post" action="/welcome" class="welcome-form">
						<div class="field">
							<label for="language">Language / Bahasa</label>
							<select id="language" name="language">
								@welcomeLangOption("en", "English", lang == "en" || lang == "")
								@welcomeLangOption("id", "Bahasa Indonesia", lang == "id")
							</select>
						</div>
						<button type="submit" class="btn btn-primary welcome-cta-btn">Get started</button>
					</form>
					<p class="welcome-hint">Runs entirely on your device.</p>
				</div>
			</div>
		</body>
	</html>
}

templ welcomeLangOption(value, label string, selected bool) {
	if selected {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

// ─── Progress bar (shared across steps 1–3) ──────────────────────────────────
templ setupProgress(step, total int, label string) {
	<div class="setup-progress">
		<div class="setup-progress-step">
			Step { itoa(step) } of { itoa(total) } — { label }
		</div>
		<div class="setup-progress-bars">
			for i := 1; i <= total; i++ {
				<div class={ "setup-progress-bar", templ.KV("done", i <= step) }></div>
			}
		</div>
	</div>
}

// ─── Step 1 — Business + timezone + hours ────────────────────────────────────
templ SetupPage(businessName, dataDir, timezone, hours, formErr string) {
	@Layout("Your business", SidebarData{HideSidebar: true}) {
		<div class="setup-wrap">
			<div class="setup-card card">
				@setupProgress(1, 3, "About your business")
				<h1 class="setup-title">About your business</h1>
				<p class="setup-lead">Tell us about your business and where its data should live. You can change any of this later.</p>
				if formErr != "" {
					<div class="alert alert-error">{ formErr }</div>
				}
				<form method="post" action="/setup">
					<div class="field">
						<label for="business_name">Business name</label>
						<input type="text" id="business_name" name="business_name" value={ businessName } placeholder="Acme Co." required/>
					</div>
					<div class="field">
						<label for="data_dir">Data directory</label>
						<input type="text" id="data_dir" name="data_dir" value={ dataDir } required/>
						<p class="hint">PicoMaju will create this folder if it does not exist.</p>
					</div>
					<div class="field">
						<label for="timezone">Timezone</label>
						<select id="timezone" name="timezone">
							@tzOption("Asia/Jakarta", timezone)
							@tzOption("Asia/Makassar", timezone)
							@tzOption("Asia/Jayapura", timezone)
							@tzOption("Asia/Singapore", timezone)
							@tzOption("Asia/Bangkok", timezone)
							@tzOption("Asia/Hong_Kong", timezone)
							@tzOption("Asia/Tokyo", timezone)
							@tzOption("Australia/Sydney", timezone)
							@tzOption("Europe/London", timezone)
							@tzOption("America/New_York", timezone)
							@tzOption("UTC", timezone)
						</select>
					</div>
					<div class="field">
						<label for="hours">Operating hours</label>
						<input type="text" id="hours" name="hours" value={ hours } placeholder="Mon–Fri, 09:00–18:00"/>
						<p class="hint">Free text — e.g. "24/7" or "Mon–Sat, 08:00–20:00".</p>
					</div>
					<div class="form-actions">
						<button type="submit" class="btn btn-primary">Continue</button>
					</div>
				</form>
			</div>
		</div>
	}
}

templ tzOption(tz, selected string) {
	if tz == selected {
		<option value={ tz } selected>{ tz }</option>
	} else {
		<option value={ tz }>{ tz }</option>
	}
}

// ─── Step 2 — First staff profile ────────────────────────────────────────────
templ FirstStaffPage(staffName, staffRole, formErr string) {
	@Layout("Create your first staff profile", SidebarData{HideSidebar: true}) {
		<div class="setup-wrap">
			<div class="setup-card card">
				@setupProgress(2, 3, "Create a staff profile")
				<h1 class="setup-title">Your first staff profile</h1>
				<p class="setup-lead">A staff profile is an agent that represents a person or role — like a receptionist or a billing clerk. You can edit or add more later.</p>
				if formErr != "" {
					<div class="alert alert-error">{ formErr }</div>
				}
				<form method="post" action="/setup/first-staff">
					<div class="field">
						<label for="label">Profile name</label>
						<input type="text" id="label" name="label" value={ staffName } placeholder="Reception Desk" required/>
					</div>
					<div class="field">
						<label for="role">Short description <span class="hint" style="font-weight:400">(optional)</span></label>
						<input type="text" id="role" name="role" value={ staffRole } placeholder="Greets customers, answers basic questions, escalates to humans"/>
					</div>
					<div class="form-actions">
						<button type="submit" class="btn btn-primary">Continue</button>
						<a href="/setup/integrations" class="btn btn-secondary">Skip for now</a>
					</div>
				</form>
			</div>
		</div>
	}
}

// ─── Step 3 — Tool picker ─────────────────────────────────────────────────────
templ IntegrationsPage(groups []tool.IntegrationGroup, formErr string) {
	@Layout("Connect your tools", SidebarData{HideSidebar: true}) {
		<div class="setup-wrap setup-wrap-wide">
			<div class="setup-integrations">
				<div class="setup-integrations-header">
					@setupProgress(3, 3, "Connect your tools")
					<h1 class="setup-title">Connect your tools</h1>
					<p class="setup-lead">Select the integrations your business uses. You can configure credentials in <strong>Tools</strong> after setup.</p>
				</div>
				if formErr != "" {
					<div class="alert alert-error">{ formErr }</div>
				}
				<form method="post" action="/setup/integrations">
					for _, group := range groups {
						<h2 class="integration-group-heading">{ group.Category }</h2>
						<div class="integration-group">
							for _, integ := range group.Integrations {
								<label class="integration-card card">
									<input
										type="checkbox"
										class="integration-toggle"
										name="integrations"
										value={ integ.ID }
									/>
									<div class="integration-info">
										<span class="integration-label">{ integ.Label }</span>
										<span class="integration-desc">{ integ.Description }</span>
									</div>
								</label>
							}
						</div>
					}
					<div class="form-actions integration-actions">
						<button type="submit" class="btn btn-primary">Finish setup</button>
						<a href="/values" class="btn btn-secondary">Skip for now</a>
					</div>
				</form>
			</div>
		</div>
	}
}

// itoa is a tiny helper so the templ expressions stay readable.
func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	neg := n < 0
	if neg {
		n = -n
	}
	var b [20]byte
	i := len(b)
	for n > 0 {
		i--
		b[i] = byte('0' + n%10)
		n /= 10
	}
	if neg {
		i--
		b[i] = '-'
	}
	return string(b[i:])
}
