package templates

import "picomaju/internal/tool"

// setupProgress renders the progress bar + step label common to all
// onboarding pages. `step` is 1-indexed and `total` is the total number
// of steps (currently 4).
templ setupProgress(step, total int, label string) {
	<div class="setup-progress">
		<div class="setup-progress-step">
			Step { itoa(step) } of { itoa(total) } — { label }
		</div>
		<div class="setup-progress-bars">
			for i := 1; i <= total; i++ {
				<div class={ "setup-progress-bar", templ.KV("done", i <= step) }></div>
			}
		</div>
	</div>
}

// ─── Step 1 — Business ──────────────────────────────────────────────────────
templ SetupPage(businessName, dataDir, formErr string) {
	@Layout("Welcome", SidebarData{HideSidebar: true}) {
		<div class="setup-wrap">
			<div class="setup-card card">
				@setupProgress(1, 4, "About your business")
				<h1 class="setup-title">Welcome to PicoMaju</h1>
				<p class="setup-lead">Tell us about your business and where its data should live. You can change any of this later.</p>
				if formErr != "" {
					<div class="alert alert-error">{ formErr }</div>
				}
				<form method="post" action="/setup">
					<div class="field">
						<label for="business_name">Business name</label>
						<input type="text" id="business_name" name="business_name" value={ businessName } placeholder="Acme Co." required/>
					</div>
					<div class="field">
						<label for="data_dir">Data directory</label>
						<input type="text" id="data_dir" name="data_dir" value={ dataDir } required/>
						<p class="hint">PicoMaju will create this folder if it does not exist.</p>
					</div>
					<div class="form-actions">
						<button type="submit" class="btn btn-primary">Continue</button>
					</div>
				</form>
			</div>
		</div>
	}
}

// ─── Step 2 — Languages / Timezone / Hours ─────────────────────────────────
templ LanguagesPage(langs []string, timezone, hours, formErr string) {
	@Layout("How you operate", SidebarData{HideSidebar: true}) {
		<div class="setup-wrap">
			<div class="setup-card card">
				@setupProgress(2, 4, "How you operate")
				<h1 class="setup-title">How do you operate?</h1>
				<p class="setup-lead">PicoMaju uses these defaults when drafting replies, routing tasks, and checking timing-sensitive rules.</p>
				if formErr != "" {
					<div class="alert alert-error">{ formErr }</div>
				}
				<form method="post" action="/setup/languages">
					<div class="field">
						<label>Languages you operate in</label>
						<div class="pick-group">
							@langChip("id", "Bahasa Indonesia", includesStr(langs, "id"))
							@langChip("en", "English", includesStr(langs, "en"))
						</div>
						<p class="hint">You can add more from Settings after setup.</p>
					</div>
					<div class="field">
						<label for="timezone">Timezone</label>
						<select id="timezone" name="timezone">
							@tzOption("Asia/Jakarta", timezone)
							@tzOption("Asia/Makassar", timezone)
							@tzOption("Asia/Jayapura", timezone)
							@tzOption("Asia/Singapore", timezone)
							@tzOption("Asia/Bangkok", timezone)
							@tzOption("Asia/Hong_Kong", timezone)
							@tzOption("Asia/Tokyo", timezone)
							@tzOption("Australia/Sydney", timezone)
							@tzOption("Europe/London", timezone)
							@tzOption("America/New_York", timezone)
							@tzOption("UTC", timezone)
						</select>
					</div>
					<div class="field">
						<label for="hours">Operating hours</label>
						<input type="text" id="hours" name="hours" value={ hours } placeholder="Mon–Fri, 9:00–18:00"/>
						<p class="hint">Free text for now — e.g. "24/7" or "Mon–Sat, 08:00–20:00".</p>
					</div>
					<div class="form-actions">
						<button type="submit" class="btn btn-primary">Continue</button>
					</div>
				</form>
			</div>
		</div>
	}
}

templ langChip(code, label string, checked bool) {
	<label class="pick-chip">
		if checked {
			<input class="pick-toggle" type="checkbox" name="languages" value={ code } checked/>
		} else {
			<input class="pick-toggle" type="checkbox" name="languages" value={ code }/>
		}
		<span class="pick-chip-label">{ label }</span>
	</label>
}

templ tzOption(tz, selected string) {
	if tz == selected {
		<option value={ tz } selected>{ tz }</option>
	} else {
		<option value={ tz }>{ tz }</option>
	}
}

// ─── Step 3 — First staff profile ──────────────────────────────────────────
templ FirstStaffPage(staffName, staffRole, formErr string) {
	@Layout("Create your first staff profile", SidebarData{HideSidebar: true}) {
		<div class="setup-wrap">
			<div class="setup-card card">
				@setupProgress(3, 4, "Create a staff profile")
				<h1 class="setup-title">Your first staff profile</h1>
				<p class="setup-lead">A staff profile is an agent that represents a person or role — like a receptionist or a billing clerk. You can edit or add more later.</p>
				if formErr != "" {
					<div class="alert alert-error">{ formErr }</div>
				}
				<form method="post" action="/setup/first-staff">
					<div class="field">
						<label for="label">Profile name</label>
						<input type="text" id="label" name="label" value={ staffName } placeholder="Reception Desk" required/>
					</div>
					<div class="field">
						<label for="role">Short description <span class="hint" style="font-weight:400">(optional)</span></label>
						<input type="text" id="role" name="role" value={ staffRole } placeholder="Greets customers, answers basic questions, escalates to humans"/>
					</div>
					<div class="form-actions">
						<button type="submit" class="btn btn-primary">Continue</button>
						<a href="/setup/integrations" class="btn btn-secondary">Skip for now</a>
					</div>
				</form>
			</div>
		</div>
	}
}

// ─── Step 4 — Integrations ────────────────────────────────────────────────
templ IntegrationsPage(groups []tool.IntegrationGroup, formErr string) {
	@Layout("Connect your tools", SidebarData{HideSidebar: true}) {
		<div class="setup-wrap setup-wrap-wide">
			<div class="setup-integrations">
				<div class="setup-integrations-header">
					@setupProgress(4, 4, "Connect your tools")
					<h1 class="setup-title">Connect your tools</h1>
					<p class="setup-lead">Select the integrations your business uses. You can configure credentials in <strong>Tools</strong> after setup.</p>
				</div>
				if formErr != "" {
					<div class="alert alert-error">{ formErr }</div>
				}
				<form method="post" action="/setup/integrations">
					for _, group := range groups {
						<h2 class="integration-group-heading">{ group.Category }</h2>
						<div class="integration-group">
							for _, integ := range group.Integrations {
								<label class="integration-card card">
									<input
										type="checkbox"
										class="integration-toggle"
										name="integrations"
										value={ integ.ID }
									/>
									<div class="integration-info">
										<span class="integration-label">{ integ.Label }</span>
										<span class="integration-desc">{ integ.Description }</span>
									</div>
								</label>
							}
						</div>
					}
					<div class="form-actions integration-actions">
						<button type="submit" class="btn btn-primary">Finish setup</button>
						<a href="/values" class="btn btn-secondary">Skip for now</a>
					</div>
				</form>
			</div>
		</div>
	}
}

// itoa is a tiny helper so the templ expressions stay readable.
func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	neg := n < 0
	if neg {
		n = -n
	}
	var b [20]byte
	i := len(b)
	for n > 0 {
		i--
		b[i] = byte('0' + n%10)
		n /= 10
	}
	if neg {
		i--
		b[i] = '-'
	}
	return string(b[i:])
}
