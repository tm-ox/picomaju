package templates

// EmptyState renders an illustrated empty-state card with a primary CTA
// and an optional secondary "learn more" link.
//
// Use on any list page when the underlying store returns zero items.
//
//   @EmptyState(EmptyStateArgs{
//       Title:         "No values yet",
//       Desc:          "Values are rules your AI agents follow — like tone, do's and don'ts.",
//       PrimaryHref:   "/values/new",
//       PrimaryLabel:  "Create your first value",
//       Icon:          emptyIconValues(),
//   })
type EmptyStateArgs struct {
	Title         string
	Desc          string
	PrimaryHref   string
	PrimaryLabel  string
	SecondaryHref string
	SecondaryText string
}

templ EmptyState(a EmptyStateArgs, icon templ.Component) {
	<div class="empty-state">
		<div class="empty-state-ill">
			@icon
		</div>
		<h2 class="empty-state-title">{ a.Title }</h2>
		if a.Desc != "" {
			<p class="empty-state-desc">{ a.Desc }</p>
		}
		<div class="empty-state-actions">
			if a.PrimaryHref != "" && a.PrimaryLabel != "" {
				<a class="btn btn-primary" href={ templ.SafeURL(a.PrimaryHref) }>{ a.PrimaryLabel }</a>
			}
			if a.SecondaryHref != "" && a.SecondaryText != "" {
				<a class="empty-state-link" href={ templ.SafeURL(a.SecondaryHref) }>{ a.SecondaryText }</a>
			}
		</div>
	</div>
}

// ─── Illustrations — simple line glyphs, one per section ─────────────────

templ EmptyIconValues() {
	<svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M40 10l8 18 20 2-15 13 5 21-18-11-18 11 5-21L12 30l20-2z"/>
	</svg>
}

templ EmptyIconTools() {
	<svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M50 14a14 14 0 0116 19l15 15-7 7-15-15a14 14 0 01-19-16l8 8 8-8-6-10z"/>
		<path d="M10 66l18-18"/>
	</svg>
}

templ EmptyIconTasks() {
	<svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect x="14" y="14" width="52" height="52" rx="6"/>
		<path d="M24 38l10 10 20-22"/>
	</svg>
}

templ EmptyIconStaff() {
	<svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="40" cy="28" r="12"/>
		<path d="M14 66c3-13 14-20 26-20s23 7 26 20"/>
	</svg>
}
