package templates

import "picomaju/internal/tool"

templ ToolListPage(tools []tool.Tool, sb SidebarData) {
	@Layout("Tools", sb) {
		<div class="page-header">
			<h1>Tools</h1>
			<a href="/tools/new" class="btn btn-primary">Add Tool</a>
		</div>
		if len(tools) == 0 {
			@EmptyState(EmptyStateArgs{
				Title:        "No tools added",
				Desc:         "Connect the integrations your business uses so staff can read and write to them.",
				PrimaryHref:  "/tools/new",
				PrimaryLabel: "Add your first tool",
			}, EmptyIconTools())
		} else {
			<table>
				<thead>
					<tr>
						<th>Label</th>
						<th>Type</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, t := range tools {
						<tr>
							<td>{ t.Label }</td>
							<td><span class="cat-tag">{ t.Type }</span></td>
							@rowActions("/tools/"+t.ID+"/edit", "/tools/"+t.ID+"/delete", "tool")
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

templ NewToolPage(groups []tool.IntegrationGroup, sb SidebarData, formErr string) {
	@Layout("Add Tool", sb) {
		<div class="page-header">
			<h1>Add Tool</h1>
			<a href="/tools" class="btn btn-secondary">Cancel</a>
		</div>
		if formErr != "" {
			<div class="alert alert-error">{ formErr }</div>
		}
		<form method="post" action="/tools">
			for _, group := range groups {
				<h2 class="integration-group-heading">{ group.Category }</h2>
				<div class="integration-group">
					for _, integ := range group.Integrations {
						<label class="integration-card card">
							<input
								type="radio"
								class="integration-toggle"
								name="integration_id"
								value={ integ.ID }
							/>
							<div class="integration-info">
								<span class="integration-label">{ integ.Label }</span>
								<span class="integration-desc">{ integ.Description }</span>
							</div>
						</label>
					}
				</div>
			}
			<div class="form-actions" style="margin-top:2rem">
				<button type="submit" class="btn btn-primary">Add and Configure</button>
			</div>
		</form>
	}
}

templ ToolFormPage(t *tool.Tool, integ *tool.Integration, sb SidebarData, formErr string) {
	@Layout("Edit Tool", sb) {
		<div class="page-header">
			<h1>{ t.Label }</h1>
			<a href="/tools" class="btn btn-secondary">Cancel</a>
		</div>
		if formErr != "" {
			<div class="alert alert-error">{ formErr }</div>
		}
		<form method="post" action={ templ.SafeURL("/tools/" + t.ID) } class="card">
			<div class="field">
				<label>ID</label>
				<input type="text" value={ t.ID } readonly class="readonly"/>
			</div>
			<div class="field">
				<label for="label">Label</label>
				<input type="text" id="label" name="label" value={ t.Label } required/>
			</div>
			<div class="field">
				<label>Type</label>
				<span class="cat-tag">{ t.Type }</span>
			</div>
			if integ != nil && len(integ.Fields) > 0 {
				<div class="tool-config-section">
					<h3 class="tool-config-heading">Credentials</h3>
					for _, f := range integ.Fields {
						<div class="field">
							<label for={ "cfg_" + f.Key }>{ f.Label }</label>
							if f.Secret {
								<input
									type="password"
									id={ "cfg_" + f.Key }
									name={ "cfg_" + f.Key }
									value={ configValue(t.Config, f.Key) }
									placeholder={ f.Placeholder }
									autocomplete="off"
								/>
							} else {
								<input
									type="text"
									id={ "cfg_" + f.Key }
									name={ "cfg_" + f.Key }
									value={ configValue(t.Config, f.Key) }
									placeholder={ f.Placeholder }
								/>
							}
						</div>
					}
				</div>
			}
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">Save</button>
				<form method="post" action={ templ.SafeURL("/tools/" + t.ID + "/delete") } style="display:inline">
					<button type="submit" class="btn btn-danger" onclick="return confirm('Delete this tool?')">Delete</button>
				</form>
			</div>
		</form>
	}
}

func configValue(cfg map[string]any, key string) string {
	if cfg == nil {
		return ""
	}
	v, ok := cfg[key]
	if !ok {
		return ""
	}
	s, _ := v.(string)
	return s
}
