package templates

import "picomaju/internal/tool"

templ ToolListPage(tools []tool.Tool, sb SidebarData) {
	@Layout("Tools", sb) {
		<div class="page-header">
			<h1>Tools</h1>
			<div class="page-header-actions">
				<a href="/tools/new" class="btn btn-secondary">Add Integration</a>
				<a href="/tools/new/skill" class="btn btn-primary">New Skill</a>
			</div>
		</div>
		if len(tools) == 0 {
			<p class="empty">No tools defined yet. <a href="/tools/new">Add an integration</a> or <a href="/tools/new/skill">create a skill</a>.</p>
		} else {
			<table>
				<thead>
					<tr>
						<th>Label</th>
						<th>Type</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, t := range tools {
						<tr>
							<td>{ t.Label }</td>
							<td><span class="cat-tag">{ t.Type }</span></td>
							<td class="actions">
								<a href={ templ.SafeURL("/tools/" + t.ID + "/edit") } class="btn btn-secondary">Edit</a>
								<form method="post" action={ templ.SafeURL("/tools/" + t.ID + "/delete") } style="display:inline">
									<button type="submit" class="btn btn-danger" onclick="return confirm('Delete this tool?')">Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

templ NewIntegrationPage(groups []tool.IntegrationGroup, sb SidebarData, formErr string) {
	@Layout("Add Integration", sb) {
		<div class="page-header">
			<h1>Add Integration</h1>
			<a href="/tools" class="btn btn-secondary">Cancel</a>
		</div>
		if formErr != "" {
			<div class="alert alert-error">{ formErr }</div>
		}
		<form method="post" action="/tools">
			for _, group := range groups {
				<h2 class="integration-group-heading">{ group.Category }</h2>
				<div class="integration-group">
					for _, integ := range group.Integrations {
						<label class="integration-card card">
							<input
								type="radio"
								class="integration-toggle"
								name="integration_id"
								value={ integ.ID }
							/>
							<div class="integration-info">
								<span class="integration-label">{ integ.Label }</span>
								<span class="integration-desc">{ integ.Description }</span>
							</div>
						</label>
					}
				</div>
			}
			<div class="form-actions" style="margin-top:2rem">
				<button type="submit" class="btn btn-primary">Add and Configure</button>
			</div>
		</form>
	}
}

templ ToolFormPage(t *tool.Tool, integ *tool.Integration, sb SidebarData, formErr string) {
	@Layout("Edit Integration", sb) {
		<div class="page-header">
			<h1>{ t.Label }</h1>
			<a href="/tools" class="btn btn-secondary">Cancel</a>
		</div>
		if formErr != "" {
			<div class="alert alert-error">{ formErr }</div>
		}
		<form method="post" action={ templ.SafeURL("/tools/" + t.ID) } class="card">
			<div class="field">
				<label>ID</label>
				<input type="text" value={ t.ID } readonly class="readonly"/>
			</div>
			<div class="field">
				<label for="label">Label</label>
				<input type="text" id="label" name="label" value={ t.Label } required/>
			</div>
			<div class="field">
				<label>Type</label>
				<span class="cat-tag">{ t.Type }</span>
			</div>
			if integ != nil && len(integ.Fields) > 0 {
				<div class="tool-config-section">
					<h3 class="tool-config-heading">Credentials</h3>
					for _, f := range integ.Fields {
						<div class="field">
							<label for={ "cfg_" + f.Key }>{ f.Label }</label>
							if f.Secret {
								<input
									type="password"
									id={ "cfg_" + f.Key }
									name={ "cfg_" + f.Key }
									value={ configValue(t.Config, f.Key) }
									placeholder={ f.Placeholder }
									autocomplete="off"
								/>
							} else {
								<input
									type="text"
									id={ "cfg_" + f.Key }
									name={ "cfg_" + f.Key }
									value={ configValue(t.Config, f.Key) }
									placeholder={ f.Placeholder }
								/>
							}
						</div>
					}
				</div>
			}
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">Save</button>
				<form method="post" action={ templ.SafeURL("/tools/" + t.ID + "/delete") } style="display:inline">
					<button type="submit" class="btn btn-danger" onclick="return confirm('Delete this integration?')">Delete</button>
				</form>
			</div>
		</form>
	}
}

templ SkillFormPage(t *tool.Tool, sb SidebarData, isNew bool, formErr string) {
	@Layout(skillFormTitle(isNew), sb) {
		<div class="page-header">
			<h1>{ skillFormTitle(isNew) }</h1>
			<a href="/tools" class="btn btn-secondary">Cancel</a>
		</div>
		if formErr != "" {
			<div class="alert alert-error">{ formErr }</div>
		}
		<form method="post" action={ templ.SafeURL(skillFormAction(t.ID, isNew)) } class="card">
			<div class="field">
				<label for="id">ID</label>
				if isNew {
					<input type="text" id="id" name="id" value={ t.ID } placeholder="handle_escalation" required/>
				} else {
					<input type="text" value={ t.ID } readonly class="readonly"/>
				}
			</div>
			<div class="field">
				<label for="label">Name</label>
				<input type="text" id="label" name="label" value={ t.Label } placeholder="Handle Escalation" required/>
			</div>
			<div class="field">
				<label for="content">SKILL.md</label>
				<p class="hint">Define how the agent executes this skill. Uses markdown.</p>
				<textarea id="content" name="content" class="skill-editor" rows="24">{ skillContent(t) }</textarea>
			</div>
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">Save Skill</button>
				if !isNew {
					<form method="post" action={ templ.SafeURL("/tools/" + t.ID + "/delete") } style="display:inline">
						<button type="submit" class="btn btn-danger" onclick="return confirm('Delete this skill?')">Delete</button>
					</form>
				}
			</div>
		</form>
	}
}

func skillFormTitle(isNew bool) string {
	if isNew {
		return "New Skill"
	}
	return "Edit Skill"
}

func skillFormAction(id string, isNew bool) string {
	if isNew {
		return "/tools/skill"
	}
	return "/tools/" + id
}

func skillContent(t *tool.Tool) string {
	if t.Config != nil {
		if v, ok := t.Config["content"]; ok {
			if s, ok := v.(string); ok && s != "" {
				return s
			}
		}
	}
	return `# Skill Name

## Purpose
Describe what this skill achieves and when it adds value.

## When to Activate
- Describe the conditions or triggers that should invoke this skill
- Add more conditions as needed

## Procedure
1. First, do X
2. Then, do Y
3. Finally, produce Z

## Output
Describe the expected output or deliverable.

## Notes
Any additional constraints, examples, or context.`
}

func toolFormAction(id string, isNew bool) string {
	if isNew {
		return "/tools"
	}
	return "/tools/" + id
}

func configValue(cfg map[string]any, key string) string {
	if cfg == nil {
		return ""
	}
	v, ok := cfg[key]
	if !ok {
		return ""
	}
	s, _ := v.(string)
	return s
}
