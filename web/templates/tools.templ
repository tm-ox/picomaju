package templates

import "picomaju/internal/tool"

templ ToolListPage(tools []tool.Tool, sb SidebarData) {
	@Layout("Tools", sb) {
		<div class="page-header">
			<h1>Tools</h1>
			<a href="/tools/new" class="btn btn-primary">New Tool</a>
		</div>
		if len(tools) == 0 {
			<p class="empty">No tools defined yet. <a href="/tools/new">Add one.</a></p>
		} else {
			<table>
				<thead>
					<tr>
						<th>Label</th>
						<th>Type</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, t := range tools {
						<tr>
							<td>{ t.Label }</td>
							<td><span class="cat-tag">{ t.Type }</span></td>
							<td class="actions">
								<a href={ templ.SafeURL("/tools/" + t.ID + "/edit") } class="btn btn-secondary">Edit</a>
								<form method="post" action={ templ.SafeURL("/tools/" + t.ID + "/delete") } style="display:inline">
									<button type="submit" class="btn btn-danger" onclick="return confirm('Delete this tool?')">Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

templ ToolFormPage(t *tool.Tool, sb SidebarData, isNew bool, formErr string) {
	@Layout(toolFormTitle(isNew), sb) {
		<div class="page-header">
			<h1>{ toolFormTitle(isNew) }</h1>
			<a href="/tools" class="btn btn-secondary">Cancel</a>
		</div>
		if formErr != "" {
			<div class="alert alert-error">{ formErr }</div>
		}
		<form method="post" action={ templ.SafeURL(toolFormAction(t.ID, isNew)) } class="card">
			<div class="field">
				<label for="id">ID</label>
				if isNew {
					<input type="text" id="id" name="id" value={ t.ID } placeholder="email_sendgrid" required/>
				} else {
					<input type="text" id="id" name="id" value={ t.ID } readonly class="readonly"/>
				}
			</div>
			<div class="field">
				<label for="label">Label</label>
				<input type="text" id="label" name="label" value={ t.Label } placeholder="SendGrid Email" required/>
			</div>
			<div class="field">
				<label for="type">Type</label>
				<select id="type" name="type" required>
					<option value="">— select —</option>
					<option value="email" selected?={ t.Type == "email" }>Email</option>
					<option value="whatsapp" selected?={ t.Type == "whatsapp" }>WhatsApp</option>
					<option value="mcp" selected?={ t.Type == "mcp" }>MCP</option>
					<option value="other" selected?={ t.Type == "other" }>Other</option>
				</select>
			</div>
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">Save</button>
			</div>
		</form>
	}
}

func toolFormTitle(isNew bool) string {
	if isNew {
		return "New Tool"
	}
	return "Edit Tool"
}

func toolFormAction(id string, isNew bool) string {
	if isNew {
		return "/tools"
	}
	return "/tools/" + id
}
