package templates

import (
	"picomaju/internal/staff"
	"picomaju/internal/task"
	"picomaju/internal/value"
)

templ StaffListPage(members []staff.Staff, sb SidebarData) {
	@Layout("Staff", sb) {
		<div class="page-header">
			<h1>Staff</h1>
			<a href="/staff/new" class="btn btn-primary">New Staff</a>
		</div>
		if len(members) == 0 {
			@EmptyState(EmptyStateArgs{
				Title:        "No staff profiles",
				Desc:         "A staff profile is an agent that represents a person or role — like a receptionist or billing clerk.",
				PrimaryHref:  "/staff/new",
				PrimaryLabel: "Create your first staff",
			}, EmptyIconStaff())
		} else {
			<table>
				<thead>
					<tr>
						<th>Label</th>
						<th>Tasks</th>
						<th>Values</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, m := range members {
						<tr>
							<td>{ m.Label }</td>
							<td>{ countWord(len(m.Tasks), "task", "tasks") }</td>
							<td>{ countWord(len(m.ValueCategories)+len(m.Values), "value ref", "value refs") }</td>
							@rowActions("/staff/"+m.ID+"/edit", "/staff/"+m.ID+"/delete", "staff member")
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

templ StaffFormPage(m *staff.Staff, tasks []task.Task, values []*value.Value, sb SidebarData, isNew bool, formErr string) {
	@Layout(formTitle("Staff", isNew), sb) {
		<div class="page-header">
			<h1>{ formTitle("Staff", isNew) }</h1>
			<a href="/staff" class="btn btn-secondary">Cancel</a>
		</div>
		if formErr != "" {
			<div class="alert alert-error">{ formErr }</div>
		}
		<form method="post" action={ templ.SafeURL(formAction("/staff", m.ID, isNew)) }>
			<div class="card">
				<div class="field">
					<label for="id">ID</label>
					if isNew {
						<input type="text" id="id" name="id" value={ m.ID } placeholder="support_agent" required/>
					} else {
						<input type="text" id="id" name="id" value={ m.ID } readonly class="readonly"/>
					}
				</div>
				<div class="field">
					<label for="label">Label</label>
					<input type="text" id="label" name="label" value={ m.Label } placeholder="Support Agent" required/>
				</div>
			</div>
			if len(tasks) > 0 {
				<div class="card">
					<h2>Tasks</h2>
					<div class="pick-group">
						for _, t := range tasks {
							<label class="pick-chip pick-chip-block">
								<input
									type="checkbox"
									class="pick-toggle"
									name="tasks"
									value={ t.ID }
									checked?={ includesStr(m.Tasks, t.ID) }
								/>
								<span class="pick-chip-label">{ t.Label }</span>
								if t.Description != "" {
									<span class="pick-chip-hint">{ t.Description }</span>
								}
							</label>
						}
					</div>
				</div>
			}
			if len(sb.Categories) > 0 {
				<div class="card">
					<h2>Values</h2>
					<p class="hint">Select a category to include all its values, or pick individual values.</p>
					for _, cat := range sb.Categories {
						<div class="cat-block">
							<label class="pick-chip pick-chip-cat">
								<input
									type="checkbox"
									class="pick-toggle"
									name="value_categories"
									value={ cat.ID }
									checked?={ includesStr(m.ValueCategories, cat.ID) }
								/>
								{ cat.Label }
							</label>
							@staffValuePicker(cat.ID, values, m.Values)
						</div>
					}
				</div>
			}
			<div class="form-actions" style="margin-top:1.5rem">
				<button type="submit" class="btn btn-primary">Save</button>
			</div>
		</form>
	}
}

templ staffValuePicker(catID string, values []*value.Value, selected []string) {
	<div class="pick-group sop-picker">
		for _, v := range values {
			if v.Category == catID {
				<label class="pick-chip">
					<input
						type="checkbox"
						class="pick-toggle"
						name="values"
						value={ v.ID }
						checked?={ includesStr(selected, v.ID) }
					/>
					{ v.Title }
				</label>
			}
		}
	</div>
}
