package templates

import (
	"fmt"
	"picomaju/internal/role"
	"picomaju/internal/tool"
)

templ RoleListPage(roles []role.Role, sb SidebarData) {
	@Layout("Roles", sb) {
		<div class="page-header">
			<h1>Roles</h1>
			<a href="/roles/new" class="btn btn-primary">New Role</a>
		</div>
		if len(roles) == 0 {
			<p class="empty">No roles defined yet. <a href="/roles/new">Create one.</a></p>
		} else {
			<table>
				<thead>
					<tr>
						<th>Label</th>
						<th>Description</th>
						<th>Tools</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, r := range roles {
						<tr>
							<td>{ r.Label }</td>
							<td>{ r.Description }</td>
							<td>{ roleToolCount(r) }</td>
							<td class="actions">
								<a href={ templ.SafeURL("/roles/" + r.ID + "/edit") } class="btn btn-secondary">Edit</a>
								<form method="post" action={ templ.SafeURL("/roles/" + r.ID + "/delete") } style="display:inline">
									<button type="submit" class="btn btn-danger" onclick="return confirm('Delete this role?')">Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

templ RoleFormPage(r *role.Role, tools []tool.Tool, sb SidebarData, isNew bool, formErr string) {
	@Layout(roleFormTitle(isNew), sb) {
		<div class="page-header">
			<h1>{ roleFormTitle(isNew) }</h1>
			<a href="/roles" class="btn btn-secondary">Cancel</a>
		</div>
		if formErr != "" {
			<div class="alert alert-error">{ formErr }</div>
		}
		<form method="post" action={ templ.SafeURL(roleFormAction(r.ID, isNew)) } class="card">
			<div class="field">
				<label for="id">ID</label>
				if isNew {
					<input type="text" id="id" name="id" value={ r.ID } placeholder="manage_social_media" required/>
				} else {
					<input type="text" id="id" name="id" value={ r.ID } readonly class="readonly"/>
				}
			</div>
			<div class="field">
				<label for="label">Label</label>
				<input type="text" id="label" name="label" value={ r.Label } placeholder="Manage Social Media" required/>
			</div>
			<div class="field">
				<label for="description">Description</label>
				<textarea id="description" name="description" placeholder="What this role does…">{ r.Description }</textarea>
			</div>
			if len(tools) > 0 {
				<div class="field">
					<label>Tools</label>
					<div class="pick-group">
						for _, t := range tools {
							<label class="pick-chip">
								<input
									type="checkbox"
									class="pick-toggle"
									name="tools"
									value={ t.ID }
									checked?={ includesStr(r.Tools, t.ID) }
								/>
								{ t.Label }<span class="cat-tag">{ t.Type }</span>
							</label>
						}
					</div>
				</div>
			}
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">Save</button>
			</div>
		</form>
	}
}

func roleFormTitle(isNew bool) string {
	if isNew {
		return "New Role"
	}
	return "Edit Role"
}

func roleFormAction(id string, isNew bool) string {
	if isNew {
		return "/roles"
	}
	return "/roles/" + id
}

func roleToolCount(r role.Role) string {
	n := len(r.Tools)
	if n == 0 {
		return "—"
	}
	if n == 1 {
		return "1 tool"
	}
	return fmt.Sprintf("%d tools", n)
}
