package templates

import (
	"picomaju/internal/task"
	"picomaju/internal/tool"
)

templ TaskListPage(tasks []task.Task, sb SidebarData) {
	@Layout("Tasks", sb) {
		<div class="page-header">
			<h1>Tasks</h1>
			<a href="/tasks/new" class="btn btn-primary">New Task</a>
		</div>
		if len(tasks) == 0 {
			@EmptyState(EmptyStateArgs{
				Title:        "No tasks defined",
				Desc:         "Tasks are playbooks — a sequence of steps a staff profile can carry out end-to-end.",
				PrimaryHref:  "/tasks/new",
				PrimaryLabel: "Create your first task",
			}, EmptyIconTasks())
		} else {
			<table>
				<thead>
					<tr>
						<th>Label</th>
						<th>Description</th>
						<th>Tools</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, t := range tasks {
						<tr>
							<td>{ t.Label }</td>
							<td>{ t.Description }</td>
							<td>{ countWord(len(t.Tools), "tool", "tools") }</td>
							@rowActions("/tasks/"+t.ID+"/edit", "/tasks/"+t.ID+"/delete", "task")
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

templ TaskFormPage(t *task.Task, tools []tool.Tool, sb SidebarData, isNew bool, formErr string) {
	@Layout(formTitle("Task", isNew), sb) {
		<div class="page-header">
			<h1>{ formTitle("Task", isNew) }</h1>
			<a href="/tasks" class="btn btn-secondary">Cancel</a>
		</div>
		if formErr != "" {
			<div class="alert alert-error">{ formErr }</div>
		}
		<form method="post" action={ templ.SafeURL(formAction("/tasks", t.ID, isNew)) } class="card">
			<div class="field">
				<label for="id">ID</label>
				if isNew {
					<input type="text" id="id" name="id" value={ t.ID } placeholder="manage_social_media" required/>
				} else {
					<input type="text" id="id" name="id" value={ t.ID } readonly class="readonly"/>
				}
			</div>
			<div class="field">
				<label for="label">Label</label>
				<input type="text" id="label" name="label" value={ t.Label } placeholder="Manage Social Media" required/>
			</div>
			<div class="field">
				<label for="description">Description</label>
				<textarea id="description" name="description" placeholder="What this task does…">{ t.Description }</textarea>
			</div>
			if len(tools) > 0 {
				<div class="field">
					<label>Tools</label>
					<div class="pick-group">
						for _, tl := range tools {
							<label class="pick-chip">
								<input
									type="checkbox"
									class="pick-toggle"
									name="tools"
									value={ tl.ID }
									checked?={ includesStr(t.Tools, tl.ID) }
								/>
								{ tl.Label }<span class="cat-tag">{ tl.Type }</span>
							</label>
						}
					</div>
				</div>
			}
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">Save</button>
			</div>
		</form>
	}
}
