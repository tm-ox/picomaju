package templates

import (
	"fmt"
	"picomaju/internal/task"
	"picomaju/internal/tool"
)

templ TaskListPage(tasks []task.Task, sb SidebarData) {
	@Layout("Tasks", sb) {
		<div class="page-header">
			<h1>Tasks</h1>
			<a href="/tasks/new" class="btn btn-primary">New Task</a>
		</div>
		if len(tasks) == 0 {
			<p class="empty">No tasks defined yet. <a href="/tasks/new">Create one.</a></p>
		} else {
			<table>
				<thead>
					<tr>
						<th>Label</th>
						<th>Description</th>
						<th>Tools</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, t := range tasks {
						<tr>
							<td>{ t.Label }</td>
							<td>{ t.Description }</td>
							<td>{ taskToolCount(t) }</td>
							<td class="actions">
								<a href={ templ.SafeURL("/tasks/" + t.ID + "/edit") } class="btn btn-secondary">Edit</a>
								<form method="post" action={ templ.SafeURL("/tasks/" + t.ID + "/delete") } style="display:inline">
									<button type="submit" class="btn btn-danger" onclick="return confirm('Delete this task?')">Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

templ TaskFormPage(t *task.Task, tools []tool.Tool, sb SidebarData, isNew bool, formErr string) {
	@Layout(taskFormTitle(isNew), sb) {
		<div class="page-header">
			<h1>{ taskFormTitle(isNew) }</h1>
			<a href="/tasks" class="btn btn-secondary">Cancel</a>
		</div>
		if formErr != "" {
			<div class="alert alert-error">{ formErr }</div>
		}
		<form method="post" action={ templ.SafeURL(taskFormAction(t.ID, isNew)) } class="card">
			<div class="field">
				<label for="id">ID</label>
				if isNew {
					<input type="text" id="id" name="id" value={ t.ID } placeholder="manage_social_media" required/>
				} else {
					<input type="text" id="id" name="id" value={ t.ID } readonly class="readonly"/>
				}
			</div>
			<div class="field">
				<label for="label">Label</label>
				<input type="text" id="label" name="label" value={ t.Label } placeholder="Manage Social Media" required/>
			</div>
			<div class="field">
				<label for="description">Description</label>
				<textarea id="description" name="description" placeholder="What this task does…">{ t.Description }</textarea>
			</div>
			if len(tools) > 0 {
				<div class="field">
					<label>Tools</label>
					<div class="pick-group">
						for _, tl := range tools {
							<label class="pick-chip">
								<input
									type="checkbox"
									class="pick-toggle"
									name="tools"
									value={ tl.ID }
									checked?={ includesStr(t.Tools, tl.ID) }
								/>
								{ tl.Label }<span class="cat-tag">{ tl.Type }</span>
							</label>
						}
					</div>
				</div>
			}
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">Save</button>
			</div>
		</form>
	}
}

func taskFormTitle(isNew bool) string {
	if isNew {
		return "New Task"
	}
	return "Edit Task"
}

func taskFormAction(id string, isNew bool) string {
	if isNew {
		return "/tasks"
	}
	return "/tasks/" + id
}

func taskToolCount(t task.Task) string {
	n := len(t.Tools)
	if n == 0 {
		return "—"
	}
	if n == 1 {
		return "1 tool"
	}
	return fmt.Sprintf("%d tools", n)
}
