package templates

import (
	"fmt"
	"picomaju/internal/value"
)

templ ValueListPage(values []*value.Value, sb SidebarData) {
	@Layout("Values", sb) {
		<div class="page-header">
			<h1>
				if sb.ActiveCat != "" {
					{ categoryLabel(sb.Categories, sb.ActiveCat) }
				} else {
					Values
				}
			</h1>
			<a href="/values/new" class="btn btn-primary">New Value</a>
		</div>
		if len(values) == 0 {
			@EmptyState(EmptyStateArgs{
				Title:        "No values yet",
				Desc:         "Values are rules your AI agents follow — tone, do's, don'ts, escalation triggers.",
				PrimaryHref:  "/values/new",
				PrimaryLabel: "Create your first value",
			}, EmptyIconValues())
		} else {
			@valueTable(values, sb)
		}
	}
}

templ valueTable(values []*value.Value, sb SidebarData) {
	<table>
		<thead>
			<tr>
				<th>Title</th>
				<th>Category</th>
				<th>Priority</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			for _, v := range values {
				<tr>
					<td>{ v.Title }</td>
					<td>
						<a href={ templ.SafeURL("/values?cat=" + v.Category) } class="cat-tag">
							{ categoryLabel(sb.Categories, v.Category) }
						</a>
					</td>
					<td>{ fmt.Sprintf("%d", v.Priority) }</td>
					<td class="actions">
						<a href={ templ.SafeURL("/values/" + v.ID + "/edit") } class="btn btn-icon" title="Edit">@iconEdit()</a>
						<form method="post" action={ templ.SafeURL("/values/" + v.ID + "/delete") } style="display:contents">
							<button type="submit" class="btn btn-icon btn-icon-danger" onclick="return confirm('Delete this value?')" title="Delete">@iconDelete()</button>
						</form>
					</td>
				</tr>
			}
		</tbody>
	</table>
}

templ ValueFormPage(v *value.Value, sb SidebarData, isNew bool, formErr string) {
	@Layout(valueFormTitle(isNew), sb) {
		<div class="page-header">
			<h1>{ valueFormTitle(isNew) }</h1>
			<a href="/values" class="btn btn-secondary">Cancel</a>
		</div>
		if formErr != "" {
			<div class="alert alert-error">{ formErr }</div>
		}
		<form method="post" action={ templ.SafeURL(valueFormAction(v.ID, isNew)) } class="card">
			<div class="field">
				<label for="id">ID</label>
				if isNew {
					<input type="text" id="id" name="id" value={ v.ID } placeholder="tone_of_voice" required/>
				} else {
					<input type="text" id="id" name="id" value={ v.ID } readonly class="readonly"/>
				}
			</div>
			<div class="field">
				<label for="title">Title</label>
				<input type="text" id="title" name="title" value={ v.Title } required/>
			</div>
			<div class="field">
				<label for="category">Category</label>
				<select id="category" name="category" required>
					<option value="">— select —</option>
					for _, c := range sb.Categories {
						<option value={ c.ID } selected?={ v.Category == c.ID }>{ c.Label }</option>
					}
				</select>
			</div>
			<div class="field">
				<label for="version">Version</label>
				<input type="number" id="version" name="version" value={ fmt.Sprintf("%d", v.Version) } min="1" required/>
			</div>
			<div class="field">
				<label for="priority">Priority (0–100)</label>
				<input type="number" id="priority" name="priority" value={ fmt.Sprintf("%d", v.Priority) } min="0" max="100" required/>
			</div>
			<div class="field">
				<label for="body">Directive</label>
				<textarea id="body" name="body">{ v.Body }</textarea>
			</div>
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">Save</button>
				if !isNew {
					<button
						type="button"
						class="btn btn-secondary"
						data-on-click={ fmt.Sprintf("@post('/values/%s/validate-stream')", v.ID) }
					>Validate</button>
				}
			</div>
		</form>
		if !isNew {
			<div id="validation-result"></div>
		}
	}
}

templ ValidationFragment(res value.ValidationResult) {
	<div id="validation-result">
		if res.Valid {
			<div class="alert alert-ok">Valid</div>
		} else {
			<div class="alert alert-error">
				<ul>
					for _, e := range res.Errors {
						<li>{ e.Field }: { e.Message }</li>
					}
				</ul>
			</div>
		}
		if len(res.Warnings) > 0 {
			<div class="alert alert-warn">
				<ul>
					for _, w := range res.Warnings {
						<li>{ w }</li>
					}
				</ul>
			</div>
		}
	</div>
}

func valueFormTitle(isNew bool) string {
	if isNew {
		return "New Value"
	}
	return "Edit Value"
}

func valueFormAction(id string, isNew bool) string {
	if isNew {
		return "/values"
	}
	return "/values/" + id
}

func categoryLabel(cats []value.Category, id string) string {
	for _, c := range cats {
		if c.ID == id {
			return c.Label
		}
	}
	return id
}
