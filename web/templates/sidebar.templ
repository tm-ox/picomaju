package templates

import "fmt"

templ sidebar(sb SidebarData) {
	<aside class="sidebar" id="sidebar">
		<div class="sidebar-inner">
			<nav class="sidebar-nav">
				if sb.ActiveSection == "values" {
					@valuesSidebar(sb)
				} else if sb.ActiveSection == "tools" {
					@toolsSidebar(sb)
				} else if sb.ActiveSection == "tasks" {
					@tasksSidebar(sb)
				} else if sb.ActiveSection == "staff" {
					@staffSidebar(sb)
				}
			</nav>
		</div>
	</aside>
}

templ sidebarHeader(label string) {
	<div class="sidebar-header">
		<button
			class="sidebar-toggle"
			aria-label="Collapse sidebar"
			aria-expanded="true"
			aria-controls="sidebar"
			onclick="
				var s = document.getElementById('sidebar');
				var collapsed = s.classList.toggle('collapsed');
				localStorage.setItem('sidebar-collapsed', collapsed ? '1' : '0');
				this.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
				this.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
			"
		><span aria-hidden="true">&#8249;</span></button>
		<span class="sidebar-heading">{ label }</span>
	</div>
}

templ valuesSidebar(sb SidebarData) {
	<div class="sidebar-section">
		@sidebarHeader("Values")
		<a
			href="/values"
			class={ "sidebar-item sidebar-item-tool", templ.KV("active", sb.ActiveCat == "") }
		>
			@categoryIcon()
			<span class="sidebar-label">
				All
				<span class="sidebar-count">{ fmt.Sprintf("%d", totalValues(sb.ValueCounts)) }</span>
			</span>
		</a>
		for _, cat := range sb.Categories {
			<a
				href={ templ.SafeURL("/values?cat=" + cat.ID) }
				class={ "sidebar-item sidebar-item-tool", templ.KV("active", sb.ActiveCat == cat.ID) }
			>
				@categoryIcon()
				<span class="sidebar-label">
					{ cat.Label }
					if sb.ValueCounts[cat.ID] > 0 {
						<span class="sidebar-count">{ fmt.Sprintf("%d", sb.ValueCounts[cat.ID]) }</span>
					}
				</span>
			</a>
		}
		<a href="/values/new" class="sidebar-item sidebar-action">+ New Value</a>
	</div>
}

templ toolsSidebar(sb SidebarData) {
	<div class="sidebar-section">
		@sidebarHeader("Tools")
		for _, t := range sb.Tools {
			<a
				href={ templ.SafeURL("/tools/" + t.ID + "/edit") }
				class="sidebar-item sidebar-item-tool"
			>
				@toolIcon(t.Type)
				<span class="sidebar-label">{ t.Label }</span>
			</a>
		}
		<a href="/tools/new" class="sidebar-item sidebar-action">+ Add Tool</a>
	</div>
}

templ tasksSidebar(sb SidebarData) {
	<div class="sidebar-section">
		@sidebarHeader("Tasks")
		for _, t := range sb.Tasks {
			<a
				href={ templ.SafeURL("/tasks/" + t.ID + "/edit") }
				class="sidebar-item sidebar-item-tool"
			>
				@taskItemIcon()
				<span class="sidebar-label">{ t.Label }</span>
			</a>
		}
		<a href="/tasks/new" class="sidebar-item sidebar-action">+ New Task</a>
	</div>
}

templ staffSidebar(sb SidebarData) {
	<div class="sidebar-section">
		@sidebarHeader("Staff")
		for _, m := range sb.Staff {
			<a
				href={ templ.SafeURL("/staff/" + m.ID + "/edit") }
				class="sidebar-item sidebar-item-tool"
			>
				@staffItemIcon()
				<span class="sidebar-label">{ m.Label }</span>
			</a>
		}
		<a href="/staff/new" class="sidebar-item sidebar-action">+ New Staff</a>
	</div>
}

func totalValues(counts map[string]int) int {
	n := 0
	for _, c := range counts {
		n += c
	}
	return n
}
