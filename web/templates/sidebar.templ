package templates

import "fmt"

templ sidebar(sb SidebarData) {
	<aside class="sidebar" id="sidebar">
		<div class="sidebar-inner">
			<button
				class="sidebar-toggle"
				title="Collapse sidebar"
				onclick="
					var s = document.getElementById('sidebar');
					var collapsed = s.classList.toggle('collapsed');
					localStorage.setItem('sidebar-collapsed', collapsed ? '1' : '0');
				"
			>&#8249;</button>
			<nav class="sidebar-nav">
				if sb.ActiveSection == "values" {
					@valuesSidebar(sb)
				} else if sb.ActiveSection == "tools" {
					@toolsSidebar(sb)
				} else if sb.ActiveSection == "roles" {
					@rolesSidebar(sb)
				} else if sb.ActiveSection == "staff" {
					@staffSidebar(sb)
				}
			</nav>
		</div>
	</aside>
}

templ valuesSidebar(sb SidebarData) {
	<div class="sidebar-section">
		<span class="sidebar-heading">Values</span>
		<a
			href="/values"
			class={ "sidebar-item", templ.KV("active", sb.ActiveCat == "") }
		>
			All
			<span class="sidebar-count">{ fmt.Sprintf("%d", totalValues(sb.ValueCounts)) }</span>
		</a>
		for _, cat := range sb.Categories {
			<a
				href={ templ.SafeURL("/values?cat=" + cat.ID) }
				class={ "sidebar-item", templ.KV("active", sb.ActiveCat == cat.ID) }
			>
				{ cat.Label }
				if sb.ValueCounts[cat.ID] > 0 {
					<span class="sidebar-count">{ fmt.Sprintf("%d", sb.ValueCounts[cat.ID]) }</span>
				}
			</a>
		}
		<a href="/values/new" class="sidebar-item sidebar-action">+ New Value</a>
	</div>
}

templ toolsSidebar(sb SidebarData) {
	if len(sb.Integrations) > 0 {
		<div class="sidebar-section">
			<span class="sidebar-heading">Integrations</span>
			for _, t := range sb.Integrations {
				<a
					href={ templ.SafeURL("/tools/" + t.ID + "/edit") }
					class="sidebar-item"
				>{ t.Label }</a>
			}
		</div>
	}
	if len(sb.Skills) > 0 {
		<div class="sidebar-section">
			<span class="sidebar-heading">Skills</span>
			for _, t := range sb.Skills {
				<a
					href={ templ.SafeURL("/tools/" + t.ID + "/edit") }
					class="sidebar-item"
				>{ t.Label }</a>
			}
		</div>
	}
	<div class="sidebar-section">
		<a href="/tools/new" class="sidebar-item sidebar-action">+ Add Integration</a>
		<a href="/tools/new/skill" class="sidebar-item sidebar-action">+ New Skill</a>
	</div>
}

templ rolesSidebar(sb SidebarData) {
	<div class="sidebar-section">
		<span class="sidebar-heading">Roles</span>
		for _, r := range sb.Roles {
			<a
				href={ templ.SafeURL("/roles/" + r.ID + "/edit") }
				class="sidebar-item"
			>{ r.Label }</a>
		}
		<a href="/roles/new" class="sidebar-item sidebar-action">+ New Role</a>
	</div>
}

templ staffSidebar(sb SidebarData) {
	<div class="sidebar-section">
		<span class="sidebar-heading">Staff</span>
		for _, m := range sb.Staff {
			<a
				href={ templ.SafeURL("/staff/" + m.ID + "/edit") }
				class="sidebar-item"
			>{ m.Label }</a>
		}
		<a href="/staff/new" class="sidebar-item sidebar-action">+ New Staff</a>
	</div>
}

func totalValues(counts map[string]int) int {
	n := 0
	for _, c := range counts {
		n += c
	}
	return n
}
